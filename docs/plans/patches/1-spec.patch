+def mark_ready(spec):
+    """Leave a marker the session-band mod polls to pop its Approve/Deny prompt."""
+    marker = {"spec": str(Path(spec["path"]).resolve()), "rel": spec["rel"],
+              "branch": spec["branch"], "hash": spec_hash(spec),
+              "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
+    try:
+        ready_path(spec).parent.mkdir(parents=True, exist_ok=True)
+        ready_path(spec).write_text(json.dumps(marker, indent=2) + "\n", encoding="utf-8")
+    except OSError as e:
+        print(f"spec: could not mark ready ({e.strerror}); approve from /gates", file=sys.stderr)
+
+
+def clear_ready(spec):
+    try:
+        ready_path(spec).unlink()
+    except OSError:
+        pass
