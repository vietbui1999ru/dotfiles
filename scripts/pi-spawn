#!/usr/bin/env zsh
# pi-spawn — queue one Pi dispatch from a task file, as a pueue task run through pi-view.
#
#   pi-spawn (--tier high|medium|low | --model <provider/id[:thinking]>) --task-file <path>
#            [--cwd <dir>] [--place window|tab|split] [--on <machine>]
#
# The task text is read by the pueue task itself (`$(cat ...)` inside the command), so the
# text never sits in pueue's stored command. Outside a Herdr pane the task opens as a
# Herdr app window: PI_VIEW_APP=1 is set on the `pueue add` call, because a Claude
# background job has no HC_TERMINAL_ID of its own.
#
# Tiers read PI_DELEGATE_{HIGH,MEDIUM,LOW}_MODEL from routing.env by matching the line;
# the file is never sourced. Machine routing (--on) waits for the machine mesh (slice D).
set -u

usage() {
  print -u2 -- 'usage: pi-spawn (--tier high|medium|low | --model <provider/id[:thinking]>) --task-file <path> [--cwd <dir>] [--place window|tab|split] [--on <machine>]'
}

tier="" model="" task_file="" cwd="" place="window" on=""
while (( $# > 0 )); do
  case $1 in
    --tier|--model|--task-file|--cwd|--place|--on)
      (( $# >= 2 )) || { print -u2 -- "pi-spawn: $1 needs a value"; usage; exit 2 }
      case $1 in
        --tier) tier=$2 ;;
        --model) model=$2 ;;
        --task-file) task_file=$2 ;;
        --cwd) cwd=$2 ;;
        --place) place=$2 ;;
        --on) on=$2 ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) print -u2 -- "pi-spawn: unknown argument '$1'"; usage; exit 2 ;;
  esac
done

if [[ -n $on ]]; then
  print -u2 -- 'pi-spawn: --on arrives with the machine mesh (slice D)'
  exit 2
fi

if [[ -n $tier && -n $model ]]; then
  print -u2 -- 'pi-spawn: pass --tier or --model, not both'
  exit 2
fi
if [[ -z $tier && -z $model ]]; then
  print -u2 -- 'pi-spawn: a model is required; pass --tier high|medium|low or --model <provider/id[:thinking]>'
  exit 2
fi

script_dir=${${0:A}:h}

# Tier to model: one line per tier in routing.env, read by matching, never sourced.
if [[ -n $tier ]]; then
  case $tier in
    high) key=PI_DELEGATE_HIGH_MODEL ;;
    medium) key=PI_DELEGATE_MEDIUM_MODEL ;;
    low) key=PI_DELEGATE_LOW_MODEL ;;
    *) print -u2 -- "pi-spawn: unknown tier '$tier'; use high, medium or low"; exit 2 ;;
  esac
  routing_file=${PI_ROUTING_ENV:-$HOME/.pi/agent/routing.env}
  model=""
  if [[ -r $routing_file ]]; then
    model=$(sed -n "s/^${key}=//p" "$routing_file" | tail -n1)
  fi
  if [[ -z $model ]]; then
    print -u2 -- "pi-spawn: $key is not set in $routing_file"
    exit 2
  fi
fi

[[ -n $task_file ]] || { print -u2 -- 'pi-spawn: --task-file is required'; exit 2 }
[[ -s $task_file ]] || { print -u2 -- "pi-spawn: --task-file '$task_file' is missing or empty"; exit 2 }
task_file=${task_file:A}

case $place in
  window|tab|split) ;;
  *) print -u2 -- "pi-spawn: unknown --place '$place'; use window, tab or split"; exit 2 ;;
esac

cwd=${cwd:-$PWD}
cwd=${cwd:A}

# Slug: the task file's basename, reduced to a-z0-9-, cut to 11, plus a random 4-hex suffix.
base=${${task_file:t}:r}
slug=${(L)base}
slug=${slug//[^a-z0-9-]/-}
slug=${slug[1,11]}
[[ -n $slug ]] || slug=task
slug=${slug}-$(openssl rand -hex 2)
session_id=pueue-$slug

# The task text is read inside the pueue task, so it is never stored in pueue's command.
pueue_command="$script_dir/pi-view --tui pi --model $model --session-id $session_id -p \"\$(cat ${(q)task_file})\" < /dev/null"

task_id=$(PI_VIEW_APP=1 PI_VIEW_PLACE=$place pueue add -i --print-task-id --label "$slug" -w "$cwd" -- "$pueue_command") || {
  print -u2 -- 'pi-spawn: pueue add failed'
  exit 1
}

print -r -- "pi-spawn task=$task_id slug=$slug model=$model"
