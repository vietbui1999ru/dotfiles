#!/usr/bin/env python3
"""Scan files or stdin for secrets. The commit and push gate; never prints a value.

Uses the same PATTERNS and literal-value pass as scripts/redact, so the gate and the
redactor agree. Prints file:line: <pattern-name> per hit and exits 1; exits 0 when clean.

Usage: secret-scan [files...|-]   (no args or "-" reads stdin, labelled <stdin>)
Override: SECRETS_ENV (secrets file path, for the literal-value pass).
"""

import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path


def load_redact():
    # redact has no .py suffix, so import it by explicit loader from the sibling path.
    path = Path(__file__).resolve().parent / "redact"
    loader = importlib.machinery.SourceFileLoader("redact", str(path))
    spec = importlib.util.spec_from_loader("redact", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def scan_text(text, label, literals, patterns):
    """Return a list of 'label:line: name' hits. Values are never included."""
    hits = []
    for lineno, line in enumerate(text.splitlines(), start=1):
        for name, value in literals:
            if value in line:
                hits.append(f"{label}:{lineno}: {name}")
        for name, pattern in patterns:
            if pattern.search(line):
                hits.append(f"{label}:{lineno}: {name}")
    return hits


def main(argv):
    redact = load_redact()
    secrets_path = os.environ.get("SECRETS_ENV") or str(Path.home() / "secrets" / ".env")
    literals = redact.load_literals(secrets_path) or []
    patterns = redact.PATTERNS

    targets = argv or ["-"]
    hits = []
    status = 0
    for target in targets:
        if target == "-":
            text = sys.stdin.read()
            label = "<stdin>"
        else:
            try:
                text = Path(target).read_text(errors="replace")
            except OSError as exc:
                print(f"secret-scan: cannot read {target}: {exc.strerror}", file=sys.stderr)
                status = 2
                continue
            label = target
        hits.extend(scan_text(text, label, literals, patterns))

    for hit in hits:
        print(hit)
    if hits:
        return 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
