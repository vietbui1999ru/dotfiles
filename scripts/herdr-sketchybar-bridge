#!/opt/homebrew/bin/node
/**
 * Herdr → Sketchybar bridge.
 *
 * Event-driven after one startup snapshot. Subscribes to:
 * - pane.agent_status_changed
 * - pane.output_matched for `^NEXT: ` on the fixed plan/build panes
 *
 * Reconnects use exponential backoff. The bridge never polls Herdr after
 * subscription and only emits derived Sketchybar events.
 */

import { execFile } from "node:child_process";
import net from "node:net";
import { homedir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";

const execFileAsync = promisify(execFile);
const SOCKET = process.env.HERDR_SOCKET_PATH ?? join(homedir(), ".config", "herdr", "herdr.sock");
const SKETCHYBAR = process.env.SKETCHYBAR_BIN ?? "/opt/homebrew/bin/sketchybar";
const ROLE_BY_AGENT = new Map([
	["claude", "plan"],
	["pi", "build"],
]);
const ROLE_LABELS = new Set(["plan", "build"]);

let roleByWorkspace = new Map();
let roleByPane = new Map();
let statusByRole = new Map();
let nextByRole = new Map();
let reconnectMs = 1_000;
let socket;
let buffer = "";

function trigger(role, status, paneId, workspaceId, next) {
	const args = [
		"--trigger",
		"agent_state",
		`AGENT=${role}`,
		`STATUS=${status ?? "unknown"}`,
		`PANE=${paneId ?? ""}`,
		`WORKSPACE=${workspaceId ?? ""}`,
	];
	if (next !== undefined) args.push(`NEXT=${next}`);
	void execFileAsync(SKETCHYBAR, args).catch(() => undefined);
}

function roleFor(agent, workspaceId, paneId) {
	return roleByPane.get(paneId) ??
		roleByWorkspace.get(workspaceId) ??
		(roleByWorkspace.size === 0 ? ROLE_BY_AGENT.get(agent) : undefined);
}

function publishStatus(role, status, paneId, workspaceId) {
	statusByRole.set(role, status);
	if (status === "working") {
		nextByRole.delete(role);
		trigger(role, status, paneId, workspaceId, "");
		return;
	}
	if ((status === "done" || status === "idle") && !nextByRole.has(role)) {
		trigger(role, status, paneId, workspaceId, "done — no next step");
		return;
	}
	trigger(role, status, paneId, workspaceId);
}

function handleEvent(message) {
	if (message?.event === "pane.agent_status_changed") {
		const event = message.data;
		const role = roleFor(event?.agent, event?.workspace_id, event?.pane_id);
		if (role && event?.agent_status)
			publishStatus(role, event.agent_status, event.pane_id, event.workspace_id);
		return;
	}
	if (message?.event === "pane.output_matched") {
		const event = message.data;
		const role = roleFor(undefined, event?.read?.workspace_id, event?.pane_id);
		const next = event?.matched_line;
		if (!role || typeof next !== "string" || !next.startsWith("NEXT: ")) return;
		nextByRole.set(role, next);
		trigger(
			role,
			statusByRole.get(role) ?? "working",
			event.pane_id,
			event.read?.workspace_id,
			next,
		);
	}
}

async function seedState() {
	try {
		const [{ stdout: workspaceJson }, { stdout: agentJson }] = await Promise.all([
			execFileAsync("herdr", ["workspace", "list"], { timeout: 3_000 }),
			execFileAsync("herdr", ["agent", "list"], { timeout: 3_000 }),
		]);
		const workspaces = JSON.parse(workspaceJson).result?.workspaces ?? [];
		roleByWorkspace = new Map(
			workspaces
				.filter((workspace) => ROLE_LABELS.has(workspace.label))
				.map((workspace) => [workspace.workspace_id, workspace.label]),
		);
		const agents = JSON.parse(agentJson).result?.agents ?? [];
		roleByPane = new Map(
			agents
				.map((agent) => [roleFor(agent.agent, agent.workspace_id), agent.pane_id])
				.filter(([role, paneId]) => role && paneId),
		);
		for (const agent of agents) {
			const role = roleFor(agent.agent, agent.workspace_id, agent.pane_id);
			if (role && agent.agent_status)
				publishStatus(role, agent.agent_status, agent.pane_id, agent.workspace_id);
		}
	} catch {
		// The event stream retries; a transient startup snapshot is non-fatal.
	}
}

function subscriptions() {
	return [
		{ type: "pane.agent_status_changed" },
		...Object.entries(Object.fromEntries(roleByPane)).map(([, paneId]) => ({
			type: "pane.output_matched",
			pane_id: paneId,
			source: "recent",
			match: { type: "regex", value: "^NEXT: " },
			strip_ansi: true,
		})),
	];
}

function scheduleReconnect() {
	const delay = reconnectMs;
	reconnectMs = Math.min(reconnectMs * 2, 30_000);
	setTimeout(connect, delay);
}

function connect() {
	buffer = "";
	const next = net.createConnection(SOCKET);
	socket = next;
	next.on("connect", async () => {
		reconnectMs = 1_000;
		await seedState();
		next.write(
			`${JSON.stringify({
				id: `herdr-sketchybar-${Date.now()}`,
				method: "events.subscribe",
				params: { subscriptions: subscriptions() },
			})}\n`,
		);
	});
	next.on("data", (chunk) => {
		buffer += chunk.toString("utf8");
		for (;;) {
			const newline = buffer.indexOf("\n");
			if (newline < 0) return;
			const line = buffer.slice(0, newline);
			buffer = buffer.slice(newline + 1);
			try {
				handleEvent(JSON.parse(line));
			} catch {
				// Ignore malformed transport frames; the stream stays connected.
			}
		}
	});
	next.on("error", () => undefined);
	next.on("close", () => {
		if (socket === next) scheduleReconnect();
	});
}

connect();
