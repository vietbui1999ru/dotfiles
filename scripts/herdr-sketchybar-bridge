#!/opt/homebrew/bin/node
/**
 * Herdr → Sketchybar bridge.
 *
 * The bridge owns the status of every Claude and Pi pane in Herdr, the
 * running Pi (pueue) task count and the latest NEXT line, then sends one
 * complete state (BLOCKED, TOTAL, TOTAL_STATUS, PI, PI_STATUS, NEXT) per
 * change. Sketchybar never merges concurrent partial updates.
 * Subscriptions are per agent pane and rebuild on topology changes.
 */

import { execFile } from "node:child_process";
import net from "node:net";
import { homedir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";
import { renderState } from "./herdr-sketchybar-label.mjs";

const execFileAsync = promisify(execFile);
const SOCKET = process.env.HERDR_SOCKET_PATH ?? join(homedir(), ".config", "herdr", "herdr.sock");
const SKETCHYBAR = process.env.SKETCHYBAR_BIN ?? "/opt/homebrew/bin/sketchybar";
const PUEUE = process.env.PUEUE_BIN ?? "/opt/homebrew/bin/pueue";
const PI_POLL_MS = 5_000;
const TOPOLOGY_EVENTS = new Set([
	"workspace.created",
	"workspace.closed",
	"pane.created",
	"pane.closed",
]);

// herdr agents the pill shows: Claude panes as !/∑, Pi panes under the hammer.
const TRACKED_AGENTS = new Set(["claude", "pi"]);

let statusByPane = new Map(); // agent pane ID → { agent, status: herdr agent_status }
let latestNext; // { paneId, text } — latest NEXT line from any Claude pane
let piRunning = 0;
let lastLabel;
let reconnectMs = 1_000;
let socket;
let buffer = "";
let subscriptionRequestId;
let topologyTimer;

function logError(message, detail) {
	console.error(`[herdr-sketchybar-bridge] ${message}${detail ? `: ${detail}` : ""}`);
}

// Sends the state when it changed, so bursts of Herdr events don't each spawn
// sketchybar. `force` re-sends an unchanged state: the periodic tick uses it
// so a `sketchybar --reload` (which blanks the items) is refilled within one
// tick; identical values are a no-op for sketchybar, so nothing redraws.
function trigger(force = false) {
	const state = renderState(statusByPane.values(), piRunning, latestNext?.text);
	const label = JSON.stringify(state);
	if (label === lastLabel && !force) return;
	lastLabel = label;
	void execFileAsync(SKETCHYBAR, [
		"--trigger", "agent_state",
		`BLOCKED=${state.blocked}`, `TOTAL=${state.total}`, `TOTAL_STATUS=${state.totalStatus}`,
		`PI=${state.pi}`, `PI_STATUS=${state.piStatus}`, `NEXT=${state.next}`,
	]).catch((error) => logError("Sketchybar trigger failed", String(error)));
}

function publishStatus(paneId, status) {
	statusByPane.set(paneId, { agent: statusByPane.get(paneId).agent, status });
	// A pane that starts working again has moved past its NEXT step.
	if (status === "working" && latestNext?.paneId === paneId) latestNext = undefined;
	trigger();
}

async function refreshTopology() {
	const { stdout } = await execFileAsync("herdr", ["agent", "list"], { timeout: 3_000 });
	const agents = JSON.parse(stdout).result?.agents ?? [];
	statusByPane = new Map(
		agents
			.filter((agent) => TRACKED_AGENTS.has(agent.agent) && agent.pane_id)
			.map((agent) => [agent.pane_id, { agent: agent.agent, status: agent.agent_status }]),
	);
	if (latestNext && !statusByPane.has(latestNext.paneId)) latestNext = undefined;
	trigger();
}

// pueue has no event stream, so poll. A stopped daemon (it exits after idling)
// makes the command fail; that just means nothing is running.
async function pollPi() {
	let running = 0;
	try {
		const { stdout } = await execFileAsync(PUEUE, ["status", "--json"], { timeout: 3_000 });
		const tasks = Object.values(JSON.parse(stdout).tasks ?? {});
		running = tasks.filter((task) => task.status?.Running !== undefined).length;
	} catch {
		running = 0;
	}
	if (running === piRunning) return;
	piRunning = running;
	trigger();
}

function subscriptions() {
	const paneSubscriptions = [...statusByPane.keys()].flatMap((paneId) => [
		{ type: "pane.agent_status_changed", pane_id: paneId },
		{
			type: "pane.output_matched",
			pane_id: paneId,
			source: "recent_unwrapped",
			match: { type: "regex", value: "^\\s*NEXT: " },
			strip_ansi: true,
		},
	]);
	return [
		{ type: "workspace.created" },
		{ type: "workspace.closed" },
		{ type: "pane.created" },
		{ type: "pane.closed" },
		...paneSubscriptions,
	];
}

async function subscribe(next) {
	try {
		await refreshTopology();
		if (socket !== next || next.destroyed) return;
		subscriptionRequestId = `herdr-sketchybar-${Date.now()}`;
		next.write(`${JSON.stringify({
			id: subscriptionRequestId,
			method: "events.subscribe",
			params: { subscriptions: subscriptions() },
		})}\n`);
	} catch (error) {
		logError("Topology refresh failed", String(error));
	}
}

function scheduleTopologyRefresh(reason) {
	if (topologyTimer) return;
	topologyTimer = setTimeout(() => {
		topologyTimer = undefined;
		if (socket && !socket.destroyed) void subscribe(socket);
	}, 100);
	console.error(`[herdr-sketchybar-bridge] rebuilding subscriptions: ${reason}`);
}

function handleEvent(message) {
	if (TOPOLOGY_EVENTS.has(message?.event)) {
		scheduleTopologyRefresh(message.event);
		return;
	}
	const event = message?.data;
	const paneId = event?.pane_id;
	if (message?.event === "pane.agent_status_changed") {
		if (!statusByPane.has(paneId)) {
			scheduleTopologyRefresh(`unknown status pane ${paneId ?? "?"}`);
			return;
		}
		if (event.agent && event.agent !== statusByPane.get(paneId).agent) {
			// The pane's agent exited and something else took over.
			scheduleTopologyRefresh(`pane ${paneId} is now ${event.agent}`);
			return;
		}
		if (event.agent_status) publishStatus(paneId, event.agent_status);
		return;
	}
	if (message?.event === "pane.output_matched") {
		if (!statusByPane.has(paneId)) {
			scheduleTopologyRefresh(`unknown output pane ${paneId ?? "?"}`);
			return;
		}
		const text = typeof event.matched_line === "string" ? event.matched_line.trim() : undefined;
		if (!text?.startsWith("NEXT: ")) return;
		latestNext = { paneId, text };
		trigger();
	}
}

// A Claude or Pi started inside an existing pane fires no pane.created, so
// compare the tracked pane set on every tick and resubscribe when it differs.
async function checkAgentPanes() {
	try {
		const { stdout } = await execFileAsync("herdr", ["agent", "list"], { timeout: 3_000 });
		const panes = (JSON.parse(stdout).result?.agents ?? [])
			.filter((agent) => TRACKED_AGENTS.has(agent.agent) && agent.pane_id)
			.map((agent) => agent.pane_id);
		const changed = panes.length !== statusByPane.size || panes.some((id) => !statusByPane.has(id));
		if (changed) scheduleTopologyRefresh("agent pane set changed");
	} catch (error) {
		logError("Agent pane check failed", String(error));
	}
}

function scheduleReconnect() {
	const delay = reconnectMs;
	reconnectMs = Math.min(reconnectMs * 2, 30_000);
	setTimeout(connect, delay);
}

function handleFrame(message) {
	if (message?.error) {
		logError(`Herdr API error frame${message.id ? ` (${message.id})` : ""}`, message.error.message);
		return;
	}
	if (message?.id === subscriptionRequestId && message?.result?.type === "subscription_started") {
		reconnectMs = 1_000;
		console.error("[herdr-sketchybar-bridge] subscription_started");
		return;
	}
	handleEvent(message);
}

function connect() {
	buffer = "";
	const next = net.createConnection(SOCKET);
	socket = next;
	next.on("connect", () => void subscribe(next));
	next.on("data", (chunk) => {
		buffer += chunk.toString("utf8");
		for (;;) {
			const newline = buffer.indexOf("\n");
			if (newline < 0) return;
			const line = buffer.slice(0, newline);
			buffer = buffer.slice(newline + 1);
			try {
				handleFrame(JSON.parse(line));
			} catch (error) {
				logError("Malformed Herdr transport frame", String(error));
			}
		}
	});
	next.on("error", (error) => logError("Socket error", error.message));
	next.on("close", () => {
		if (socket === next) scheduleReconnect();
	});
}

connect();
void pollPi();
setInterval(() => {
	void pollPi();
	if (socket && !socket.destroyed) void checkAgentPanes();
	if (lastLabel !== undefined) trigger(true);
}, PI_POLL_MS);
