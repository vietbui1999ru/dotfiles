#!/usr/bin/env python3
"""bench: workflow benchmark harness (pilot). Thin entry point over scripts/bench_lib."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from scripts.bench_lib import cli_log, events  # noqa: E402


def main(argv=None):
    p = argparse.ArgumentParser(prog="bench")
    sub = p.add_subparsers(dest="cmd", required=True)
    lg = sub.add_parser("log", help="append a manual event to a run")
    lg.add_argument("run_id")
    lg.add_argument("type", choices=events.TYPES, metavar="type")
    lg.add_argument("text")
    args = p.parse_args(argv)
    if args.cmd == "log":
        return cli_log.log(args.run_id, args.type, args.text)
    return 2


if __name__ == "__main__":
    sys.exit(main())
