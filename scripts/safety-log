#!/usr/bin/env python3
"""Trace and judge the bash-safety blocks the PreToolUse hook records.

The hook appends one redacted JSON object per block to
${SAFETY_LOG_DIR:-$HOME/.claude/state}/bash-safety-blocks.jsonl, rotating the
file to bash-safety-blocks.jsonl.1 at 2000 entries. Human verdicts live beside
it in bash-safety-verdicts.jsonl, one {"id","verdict","ts"} per line, and the
last verdict for an id wins. This script reads both logs and writes only the
verdicts file. See docs/workflows/bash-safety-log.md.

Standard library only.
"""
import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

BLOCKS = "bash-safety-blocks.jsonl"
VERDICTS = "bash-safety-verdicts.jsonl"
# `mark` takes a human's judgement only; `noted` is written by `record --noted`, a logger's note.
VERDICT_CHOICES = ("ok", "false-positive")
READ_VERDICTS = VERDICT_CHOICES + ("noted",)
CAP = 4000
ROTATE_AT = 2000
# --since accepts a relative span in these units, or an ISO date.
UNITS = {"m": "minutes", "h": "hours", "d": "days", "w": "weeks"}
FIELDS = ("id", "ts", "session", "rule", "verdict", "command", "reason", "cwd", "transcript")
# enforce-bash-safety.sh first blanks -u/--user values, then pipes through scripts/redact.
USERINFO = re.compile(r"(-u|--user)([=\s]+)[^\s]+")
SHARED_REDACT = Path(__file__).resolve().parent / "redact"
# The same four substitutions, in the same order, as the jq `redact` in enforce-bash-safety.sh.
VALUE = r"""("[^"]*"|'[^']*'|[^\s]+)"""
REDACTIONS = [
    (re.compile(r"([A-Za-z_][A-Za-z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|KEY)[A-Za-z0-9_]*)=" + VALUE, re.I),
     r"\1=[REDACTED]"),
    (re.compile(r"(--(?:token|password|passwd|secret|api-key|apikey))(=|\s+)" + VALUE, re.I),
     r"\1\2[REDACTED]"),
    (re.compile(r"(gh[pos]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"),
     "[REDACTED]"),
    (re.compile(r"(Bearer)\s+[^\s\"']+", re.I), r"\1 [REDACTED]"),
]


def log_dir() -> Path:
    override = os.environ.get("SAFETY_LOG_DIR")
    if override:
        return Path(override).expanduser()
    return Path(os.environ.get("HOME") or Path.home()).expanduser() / ".claude" / "state"


def read_jsonl(path: Path) -> list[dict]:
    """A missing file or a malformed line is skipped, never fatal."""
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    rows = []
    for line in text.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def stamp(value: object) -> datetime | None:
    """An aware datetime for an ISO 8601 string; None when it does not parse."""
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.astimezone()


def redact(text: str) -> str:
    """The hook's chain: -u/--user values, then scripts/redact (skipped if missing), then REDACTIONS."""
    text = USERINFO.sub(r"\1\2[REDACTED]", text)
    try:
        text = subprocess.run([str(SHARED_REDACT)], input=text, capture_output=True,
                              text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        pass
    for pattern, replacement in REDACTIONS:
        text = pattern.sub(replacement, text)
    return text


def cap(text: str) -> str:
    return text[:CAP] + "…[truncated]" if len(text) > CAP else text


def verdicts(directory: Path) -> dict[str, str]:
    """Verdicts by block id; the last line for an id wins."""
    latest: dict[str, str] = {}
    for row in read_jsonl(directory / VERDICTS):
        if isinstance(row.get("id"), str) and row.get("verdict") in READ_VERDICTS:
            latest[row["id"]] = row["verdict"]
    return latest


def rows(directory: Path) -> list[dict]:
    """Every logged block from both files, newest first, with its verdict or None."""
    judged = verdicts(directory)
    blocks = read_jsonl(directory / f"{BLOCKS}.1") + read_jsonl(directory / BLOCKS)
    entries = [
        {**block, "verdict": judged.get(block["id"])}
        for block in blocks
        if isinstance(block.get("id"), str)
    ]
    # Newest first; equal timestamps put later log lines (the current file) first.
    epoch = datetime.fromtimestamp(0).astimezone()
    indexed = list(enumerate(entries))
    indexed.sort(key=lambda pair: (stamp(pair[1].get("ts")) or epoch, pair[0]), reverse=True)
    return [entry for _, entry in indexed]


def since_moment(text: str) -> datetime:
    now = datetime.now().astimezone()
    if len(text) > 1 and text[-1] in UNITS and text[:-1].isdigit():
        return now - timedelta(**{UNITS[text[-1]]: int(text[:-1])})
    parsed = stamp(text)
    if parsed is None:
        raise ValueError(f"--since wants 1h, 2d or an ISO date, not {text!r}")
    return parsed


def select(entries: list[dict], args: argparse.Namespace) -> list[dict]:
    since = since_moment(args.since) if args.since else None
    kept = []
    for entry in entries:
        session = entry.get("session") if isinstance(entry.get("session"), str) else ""
        if args.session and session != args.session and not session.startswith(args.session):
            continue
        if args.rule and entry.get("rule") != args.rule:
            continue
        if args.pending and entry["verdict"] is not None:
            continue
        if since is not None:
            when = stamp(entry.get("ts"))
            if when is None or when < since:
                continue
        kept.append(entry)
    return kept


def when_text(entry: dict) -> str:
    when = stamp(entry.get("ts"))
    return when.strftime("%Y-%m-%d %H:%M:%S") if when else str(entry.get("ts") or "?")


def one_line(entry: dict) -> str:
    """Time, session id shortened to 8, rule, verdict or pending, then the command on one line."""
    session = entry["session"][:8] if isinstance(entry.get("session"), str) else ""
    rule = entry.get("rule") if isinstance(entry.get("rule"), str) else "other"
    command = " ".join(str(entry.get("command") or "").split())
    return f"{when_text(entry)}  {session:<8}  {rule:<16}  {entry['verdict'] or 'pending':<13}  {command}"


def detail(entry: dict) -> str:
    """One block in full, including the fields the listing leaves out."""
    return "\n".join(f"{field}: {entry.get(field) if entry.get(field) is not None else 'pending'}" for field in FIELDS)


def false_positive_counts(entries: list[dict]) -> list[tuple[str, int]]:
    counts: dict[str, int] = {}
    for entry in entries:
        if entry["verdict"] != "false-positive":
            continue
        rule = entry.get("rule") if isinstance(entry.get("rule"), str) else "other"
        counts[rule] = counts.get(rule, 0) + 1
    return sorted(counts.items(), key=lambda pair: (-pair[1], pair[0]))


def now_stamp() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def append_verdict(directory: Path, block_id: str, verdict: str) -> None:
    path = directory / VERDICTS
    record = {"id": block_id, "verdict": verdict, "ts": now_stamp()}
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record) + "\n")


def mark(directory: Path, block_id: str, verdict: str) -> int:
    """Append one verdict; an unknown id writes nothing."""
    if block_id not in {entry["id"] for entry in rows(directory)}:
        print(f"safety-log: no block with id {block_id}", file=sys.stderr)
        return 2
    path = directory / VERDICTS
    try:
        append_verdict(directory, block_id, verdict)
    except OSError as error:
        print(f"safety-log: cannot write {path}: {error}", file=sys.stderr)
        return 1
    print(f"marked {block_id} {verdict}")
    return 0


def record(directory: Path, args: argparse.Namespace) -> int:
    """Append one redacted entry, as the Bash hook does. Best effort: never fails the caller."""
    block_id = os.urandom(6).hex()
    entry = {
        "id": block_id,
        "ts": now_stamp(),
        "session": args.session or "",
        "cwd": args.cwd or "",
        "transcript": args.transcript or "",
        "rule": args.rule,
        "command": cap(redact(args.shell_command or "")),
        "reason": args.reason,
    }
    try:
        directory.mkdir(parents=True, exist_ok=True)
        log = directory / BLOCKS
        if log.exists() and len(read_lines(log)) >= ROTATE_AT:
            os.replace(log, directory / f"{BLOCKS}.1")
        with log.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry) + "\n")
        if args.noted:
            append_verdict(directory, block_id, "noted")
    except OSError:
        return 0
    print(block_id)
    return 0


def read_lines(path: Path) -> list[str]:
    return path.read_text(encoding="utf-8", errors="replace").splitlines()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="safety-log",
        description="List and judge the commands the bash-safety hook blocked.",
        epilog="Nothing here can allow a blocked command: a verdict only feeds a human rule change.",
    )
    parser.add_argument("--session", metavar="ID", help="only this session (full id or its first 8 characters)")
    parser.add_argument("--rule", metavar="RULE", help="only this block rule")
    parser.add_argument("--since", metavar="WHEN", help="only blocks newer than 1h, 2d, 3w or an ISO date")
    parser.add_argument("--pending", action="store_true", help="only blocks still waiting for a verdict")
    parser.add_argument("--json", action="store_true", help="print the filtered blocks as one JSON array")
    parser.add_argument("--false-positives", action="store_true", help="false-positive counts per rule, the input for a rule change")
    commands = parser.add_subparsers(dest="command")
    show = commands.add_parser("show", help="print one block in full")
    show.add_argument("id")
    mark_parser = commands.add_parser("mark", help="record a human verdict for one block")
    mark_parser.add_argument("id")
    mark_parser.add_argument("verdict", choices=VERDICT_CHOICES)
    record_parser = commands.add_parser("record", help="append one redacted entry (used by the guards)")
    record_parser.add_argument("--rule", required=True)
    record_parser.add_argument("--reason", required=True)
    record_parser.add_argument("--command", dest="shell_command")
    record_parser.add_argument("--session")
    record_parser.add_argument("--cwd")
    record_parser.add_argument("--transcript")
    record_parser.add_argument("--noted", action="store_true", help="also write a noted verdict")
    args = parser.parse_args(argv)
    directory = log_dir()

    if args.command == "record":
        return record(directory, args)

    try:
        entries = rows(directory)
    except OSError as error:
        print(f"safety-log: cannot read {directory}: {error}", file=sys.stderr)
        return 1

    if args.command == "show":
        found = next((entry for entry in entries if entry["id"] == args.id), None)
        if found is None:
            print(f"safety-log: no block with id {args.id}", file=sys.stderr)
            return 1
        print(detail(found))
        return 0
    if args.command == "mark":
        return mark(directory, args.id, args.verdict)
    if args.false_positives:
        counts = false_positive_counts(entries)
        if not counts:
            print("no false positives.")
        for rule, count in counts:
            print(f"{count:>4}  {rule}")
        return 0

    try:
        selected = select(entries, args)
    except ValueError as error:
        parser.error(str(error))
    if args.json:
        print(json.dumps(selected, indent=2))
        return 0
    for entry in selected:
        print(one_line(entry))
    return 0


if __name__ == "__main__":
    sys.exit(main())
