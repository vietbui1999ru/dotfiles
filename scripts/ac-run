#!/usr/bin/env python3
"""ac-run: lint, approve and check the acceptance criteria in SPEC.md.

lint     grammar and branch check; prints the human-only approve line on success
approve  human only: macOS dialog, then records a hash and a baseline
show     prints the approval summary; runs nothing and writes nothing
check    runs the approved verify commands and classifies them against the baseline
reject   human only: removes this spec's approval record, sets status: draft, runs nothing
status   prints approved, draft or stale; exit 0 only when approved
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HUMAN = "HUMAN ONLY (agents must not run this): approve in the session-band /gates pane, or ~/dotfiles/scripts/ac-run approve SPEC.md"
REJECT = "Reject or revoke (runs nothing): ~/dotfiles/scripts/ac-run reject SPEC.md"
STATE = Path(os.path.expanduser("~")) / ".local" / "state" / "ac-run"
KEEP_ENV = ("PATH", "HOME", "USER", "LANG", "LC_ALL", "TMPDIR", "TERM")
SECTIONS = ("objective", "acceptance criteria", "boundaries", "open questions")
SUBSECTIONS = ("always", "ask first", "never")
AC_RE = re.compile(r"^- AC-(\d+):")
MANUAL_RE = re.compile(r"^manual\s*[-—:]\s*\S")


class Usage(Exception):
    """Exit 2 with these message lines."""


def git(*args, cwd):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def shown(s):
    """Escape control characters so SPEC text cannot rewrite the approve prompt."""
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode() for c in s)


def parse(lines):
    """Return (front, sections, acs, errors). front maps key -> (value, line)."""
    front, sections, acs, errors = {}, {}, [], []
    body = 0
    if lines and lines[0].strip() == "---":
        for i, line in enumerate(lines[1:], 2):
            if line.strip() == "---":
                body = i
                break
            key, sep, value = line.partition(":")
            if sep:
                front[key.strip()] = (value.strip(), i)
    section, fence, ac = None, False, None
    for i, line in enumerate(lines[body:], body + 1):
        if line.lstrip().startswith("```"):
            fence = not fence
        if fence:
            continue
        m = re.match(r"^(#{2,3})\s+(.*?)\s*$", line)
        if m:
            name = m.group(2).lower()
            if len(m.group(1)) == 2:
                section, ac = name, None
                sections.setdefault(name, {"line": i, "subs": set()})
            elif section in sections:
                sections[section]["subs"].add(name)
            continue
        if section != "acceptance criteria":
            continue
        m = AC_RE.match(line)
        if m:
            ac = {"n": int(m.group(1)), "title": line[m.end():].strip(), "line": i,
                  "verify": [], "baseline": ""}
            acs.append(ac)
        elif ac and line.strip().startswith("verify:"):
            ac["verify"].append((line.strip()[7:].strip(), i))
        elif ac and line.strip().startswith("baseline:"):
            value = line.strip()[9:].strip()
            if value.lower() != "pass":
                errors.append((i, f"AC-{ac['n']} baseline is {value!r}", "baseline: pass"))
            ac["baseline"] = "pass"
    return front, sections, acs, errors


def validate(front, sections, acs, errors):
    """Append grammar errors; set ac['cmd'] (None for manual) and ac['raw'] on good ACs."""
    for key, form in (("status", "status: draft"), ("branch", "branch: <current branch>")):
        if key not in front:
            errors.append((1, f"frontmatter has no {key}", form))
    for name in SECTIONS:
        if name not in sections:
            errors.append((1, f"missing section {name.title()}", f"## {name.title()}"))
    if "boundaries" in sections:
        b = sections["boundaries"]
        for sub in SUBSECTIONS:
            if sub not in b["subs"]:
                errors.append((b["line"], f"Boundaries has no {sub.capitalize()} subsection",
                               f"### {sub.capitalize()}"))
    if "acceptance criteria" in sections and not acs:
        errors.append((sections["acceptance criteria"]["line"], "no ACs", "- AC-1: <criterion>"))
    seen = 0
    for ac in acs:
        name = f"AC-{ac['n']}"
        if ac["n"] <= seen:
            errors.append((ac["line"], f"{name} repeats or is out of order after AC-{seen}",
                           f"- AC-{seen + 1}: (unique, ascending ids)"))
        seen = max(seen, ac["n"])
        if len(ac["verify"]) != 1:
            what = "has no verify line" if not ac["verify"] else "has more than one verify line"
            errors.append((ac["line"], f"{name} {what}", "verify: `<command>`"))
            continue
        raw, line = ac["verify"][0]
        ac["raw"] = raw
        if MANUAL_RE.match(raw):
            ac["cmd"] = None
        elif raw.count("`") >= 2 and raw[raw.index("`") + 1:raw.rindex("`")].strip():
            ac["cmd"] = raw[raw.index("`") + 1:raw.rindex("`")].strip()
        else:
            errors.append((line, f"{name} verify is neither a command nor manual",
                           "verify: `<command>` or verify: manual - <reason>"))


def load(path):
    """Parse and lint SPEC.md and check the branch. Return a spec dict or raise Usage."""
    try:
        raw = Path(path).read_bytes()
        lines = raw.decode("utf-8").splitlines()
    except OSError as e:
        raise Usage([f"{path}: cannot read: {e.strerror}"])
    except UnicodeDecodeError as e:
        raise Usage([f"{path}: not UTF-8 (byte {e.start}); expected: a UTF-8 text file"])
    front, sections, acs, errors = parse(lines)
    validate(front, sections, acs, errors)
    if errors:
        raise Usage([f"{path}:{n}: {p}; expected: {f}" for n, p, f in sorted(errors)])
    top = git("rev-parse", "--show-toplevel", cwd=Path(path).resolve().parent)
    if top is None:
        raise Usage([f"{path}: not inside a git repository"])
    want, line = front["branch"]
    have = git("branch", "--show-current", cwd=top)
    if not have:
        raise Usage([f"{path}:{line}: detached HEAD; check out branch {want}"])
    if have != want:
        raise Usage([f"{path}:{line}: branch: is {want}, current branch is {have}"])
    rel = os.path.relpath(Path(path).resolve(), Path(top).resolve())
    return {"path": path, "rel": rel, "top": top, "branch": want, "acs": acs, "raw": raw,
            "status_line": front["status"][1],
            "status": front["status"][0]}


def cmd_lint(args):
    spec = load(args.spec)
    print(f"{args.spec}: {len(spec['acs'])} ACs, lint clean")
    print(REJECT)
    print(HUMAN)
    return 0


def spec_hash(spec):
    parts = [spec["rel"].strip(), spec["branch"].strip()]
    parts += [f"AC-{a['n']}\t{a['raw'].strip()}\t{a['baseline'].strip()}" for a in spec["acs"]]
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def record_path(spec):
    return STATE / f"{spec_hash(spec)}.json"


def set_status(spec, value):
    """Rewrite only the status: line to `status: <value>`, keeping its line ending. False if the
    file changed or is not writable."""
    path = Path(spec["path"])
    if path.read_bytes() != spec["raw"]:
        return False
    lines = spec["raw"].decode("utf-8").splitlines(keepends=True)
    old = lines[spec["status_line"] - 1]
    lines[spec["status_line"] - 1] = f"status: {value}" + old[len(old.rstrip("\r\n")):]
    try:
        path.write_bytes("".join(lines).encode("utf-8"))
    except OSError:  # read-only file; the record is already written
        return False
    return True


def print_summary(spec, runnable):
    print(f"Approve {spec['rel']} on branch {spec['branch']}: {len(spec['acs'])} ACs")
    for ac in spec["acs"]:
        print(f"\n  AC-{ac['n']}: {shown(ac['title']) or '(no title)'}")
        if ac["cmd"] is None:
            print(f"    checked by a human: {shown(ac['raw'])}")
        else:
            keep = "  (baseline: pass, must keep passing)" if ac["baseline"] == "pass" else ""
            print(f"    runs: {shown(ac['cmd'])}{keep}")
    print(f"\nApproving records the {len(runnable)} commands above (a hash of every verify "
          "and baseline line), runs them once now for a baseline (skipped if the tree has "
          "changes), and sets status: approved in SPEC.md. Editing a verify or baseline "
          "line later voids the approval.")


def confirm(spec, runnable):
    """Human-only macOS dialog. No stdin or terminal fallback."""
    commands = [shown(a["cmd"])[:240] for a in runnable[:10]]
    if len(runnable) > 10:
        commands.append(f"+{len(runnable) - 10} more")
    message = (f"Approve {shown(spec['rel'])} on branch {shown(spec['branch'])}: "
               f"{len(spec['acs'])} ACs?\n\n"
               "Approving runs these commands on this machine now for a baseline:\n"
               + "\n".join(commands))
    script = [
        "on run argv",
        'display dialog (item 1 of argv) with title "ac-run" buttons {"Cancel", "Approve"} '
        'default button "Cancel" cancel button "Cancel" giving up after 60',
        "return button returned of result",
        "end run",
    ]
    command = ["/usr/bin/osascript"] + [a for line in script for a in ("-e", line)] + [message]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=75)
    except (OSError, subprocess.TimeoutExpired):
        print("Approval needs the macOS dialog; it was unavailable or timed out.", file=sys.stderr)
        return False
    if result.returncode != 0:
        print("Approval needs the macOS dialog; it was cancelled or unavailable.", file=sys.stderr)
    return result.returncode == 0 and result.stdout.strip() == "Approve"


def cmd_show(args):
    spec = load(args.spec)
    print_summary(spec, [a for a in spec["acs"] if a["cmd"] is not None])
    return 0


def cmd_approve(args):
    spec = load(args.spec)
    runnable = [a for a in spec["acs"] if a["cmd"] is not None]
    print_summary(spec, runnable)
    if not confirm(spec, runnable):
        print("not approved")
        return 1
    rec = {"spec": spec["rel"], "branch": spec["branch"],
           "approved": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "baseline": take_baseline(spec, args.timeout)}
    if Path(spec["path"]).read_bytes() != spec["raw"]:
        print(f"not approved: {args.spec} changed since it was read; run approve again")
        return 1
    STATE.mkdir(parents=True, exist_ok=True)
    record_path(spec).write_text(json.dumps(rec, indent=2) + "\n", encoding="utf-8")
    if not set_status(spec, "approved"):
        print(f"{args.spec} changed or is not writable; record written, "
              "set status: approved by hand")
    print(f"approved: record {record_path(spec)}")
    print(REJECT)
    return 0


def cmd_reject(args):
    spec = load(args.spec)
    path = record_path(spec)
    try:
        path.unlink()
        what = f"removed record {path}"
    except FileNotFoundError:
        what = "no approval record for these verify lines"
    except OSError as e:
        print(f"{args.spec}: cannot remove record {path}: {e.strerror}", file=sys.stderr)
        return 1
    status = "status: draft" if set_status(spec, "draft") else "set status: draft by hand"
    print(f"rejected {args.spec}: {what}; {status}")
    return 0


def cmd_status(args):
    spec = load(args.spec)
    try:
        json.loads(record_path(spec).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        if spec["status"] == "approved":
            print("stale (spec changed since approval; approve again)")
        else:
            print("draft (no record)")
        return 3
    print("approved (record matches)")
    return 0


def run_one(cmd, top, timeout):
    """Run cmd under /bin/sh in its own process group. Return (exit or None, seconds, tail)."""
    env = {k: os.environ[k] for k in KEEP_ENV if k in os.environ}
    start = time.monotonic()
    # Output goes to a temp file, not a pipe: a child that leaves the group (setsid) and
    # keeps the pipe open would otherwise block the read after the timeout kill.
    with tempfile.TemporaryFile() as out:
        proc = subprocess.Popen(["/bin/sh", "-c", cmd], cwd=top, env=env,
                                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                start_new_session=True)
        try:
            code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            code = None
        # Kill the group after a normal exit too, so a background child cannot change the
        # tree after the verdict.
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:  # gone, or EPERM on macOS when only the shell zombie is left
            if code is None:
                proc.kill()
        proc.wait()
        out.seek(max(0, out.seek(0, os.SEEK_END) - 65536))  # only the last 40 lines are kept
        tail = out.read().decode("utf-8", "replace").splitlines()[-40:]
    return code, time.monotonic() - start, tail


def base_ref(top):
    for ref in ("origin/HEAD", "main", "master"):
        mb = git("merge-base", "HEAD", ref, cwd=top)
        if mb:
            return mb
    return None


def tree_clean(spec):
    """True when only SPEC.md differs from the merge-base (committed or not)."""
    r = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"],
                       cwd=spec["top"], capture_output=True, text=True)
    if r.returncode or any(l[3:] != spec["rel"] for l in r.stdout.splitlines() if l):
        return False
    mb = base_ref(spec["top"])
    if mb is None:
        return False
    r = subprocess.run(["git", "diff", "--quiet", mb, "HEAD", "--", ".", f":!{spec['rel']}"],
                       cwd=spec["top"], capture_output=True)
    return r.returncode == 0


def take_baseline(spec, timeout):
    runnable = [a for a in spec["acs"] if a["cmd"] is not None]
    if not tree_clean(spec):
        print("baseline skipped: tree has changes")
        return {f"AC-{a['n']}": "unknown" for a in runnable}
    baseline = {}
    for a in runnable:
        code = run_one(a["cmd"], spec["top"], timeout)[0]
        baseline[f"AC-{a['n']}"] = "pass" if code == 0 else "fail"
        if code != 0 and a["baseline"] == "pass":
            print(f"WARN AC-{a['n']} marked baseline: pass but fails now")
    return baseline


def cmd_check(args):
    spec = load(args.spec)
    try:
        rec = json.loads(record_path(spec).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        print(f"{args.spec}: no approval record for these verify lines; "
              "a human must run: ~/dotfiles/scripts/ac-run approve SPEC.md", file=sys.stderr)
        return 3
    rec = rec if isinstance(rec, dict) else {}
    baseline = rec.get("baseline") if isinstance(rec.get("baseline"), dict) else {}
    rows, failed, tails = [], False, []
    for a in spec["acs"]:
        name = f"AC-{a['n']}"
        if a["cmd"] is None:
            rows.append((name, "MANUAL", "-", "-"))
            continue
        code, secs, tail = run_one(a["cmd"], spec["top"], args.timeout)
        result = classify(code, baseline.get(name, "unknown"), a["baseline"] == "pass")
        failed |= result in ("FAIL", "TIMEOUT", "PRE-SATISFIED")
        rows.append((name, result, "-" if code is None else str(code), f"{secs:.1f}"))
        if result in ("FAIL", "TIMEOUT"):
            tails.append((name, tail))
    print("| AC | Result | Exit | Seconds |")
    print("|---|---|---|---|")
    for row in rows:
        print("| " + " | ".join(row) + " |")
    print(f"\napproved: {rec.get('approved', 'unknown')}")
    for name, tail in tails:
        print(f"\n{name} output (last 40 lines):\n```\n" + "\n".join(tail) + "\n```")
    return 1 if failed else 0


def classify(code, baseline, keep):
    if code is None:
        return "TIMEOUT"
    if code != 0:
        return "FAIL"
    if baseline == "unknown":
        return "PASS (no baseline)"
    if baseline == "pass":
        return "PASS (kept)" if keep else "PRE-SATISFIED"
    return "PASS"


def main():
    ap = argparse.ArgumentParser(prog="ac-run", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("lint", "approve", "check", "reject", "status", "show"):
        p = sub.add_parser(name)
        if name in ("approve", "check"):
            p.add_argument("--timeout", type=int, default=120, help="seconds per AC (default 120)")
        p.add_argument("spec", metavar="SPEC_PATH")
    args = ap.parse_args()
    handler = {"lint": cmd_lint, "approve": cmd_approve, "check": cmd_check,
               "reject": cmd_reject, "status": cmd_status, "show": cmd_show}[args.cmd]
    try:
        return handler(args)
    except Usage as e:
        print("\n".join(e.args[0]), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
