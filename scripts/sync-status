#!/bin/bash
# Show, at session start, where this checkout stands against the other machines' work:
# how far the branch is behind origin/main, and which open pull requests touch the same
# files as this branch. Read-only: it fetches, never merges, rebases or pulls.
#
# Why: dotfiles are edited from more than one machine at once. A branch that only one
# machine can see, or two branches changing one file, is how duplicate and contradicting
# work starts. See docs/workflows/multi-machine.md.
#
# Usage: sync-status   (any git repository; prints nothing outside one)
# Exit: always 0, so it can run as a SessionStart hook. Offline, or without gh or glab, it says so.

PATH="$PATH:/usr/bin:/bin"
git rev-parse --git-dir >/dev/null 2>&1 || exit 0

if ! timeout 15 git fetch --quiet --prune origin 2>/dev/null; then
	echo "sync-status: fetch failed (offline?); comparing against the last fetch"
fi
branch=$(git branch --show-current)
base=origin/main
git rev-parse --verify --quiet "$base" >/dev/null || exit 0

behind=$(git rev-list --count "HEAD..$base")
echo "sync-status: ${branch:-detached} is $behind commit(s) behind $base"

# This branch's files: committed since it left main, plus uncommitted changes.
mine=$( { git diff --name-only "$base...HEAD"; git diff --name-only HEAD; } | sort -u)

# Pick the forge from origin: GitHub keeps the gh path, anything else tries glab.
url=$(git remote get-url origin 2>/dev/null)

prs=
num_prefix=
header="open pull requests"

if [[ "$url" == *github.com* ]]; then
	if ! command -v gh >/dev/null; then
		echo "sync-status: gh missing; open pull requests not checked"
	elif ! prs=$(timeout 15 gh pr list --state open --limit 50 \
		--json number,headRefName,isDraft,labels \
		-q '.[] | "\(.number)\t\(.headRefName)\t\(if .isDraft then "draft" else "open" end)\t\([.labels[].name] | join(","))"' 2>/dev/null); then
		echo "sync-status: gh pr list failed; open pull requests not checked"
	else
		num_prefix='#'
	fi
elif command -v glab >/dev/null && command -v jq >/dev/null; then
	header="open merge requests"
	num_prefix='!'
	if ! prs=$(timeout 15 glab mr list --output json --per-page 50 2>/dev/null); then
		prs=
		echo "sync-status: glab mr list failed; open merge requests not checked"
	else
		prs=$(printf '%s\n' "$prs" | jq -r '.[] | "\(.iid)\t\(.source_branch)\t\(if .draft then "draft" else "open" end)\t\([.labels[]] | join(","))"' 2>/dev/null) || prs=
	fi
else
	host=$url
	host=${host#*://}
	host=${host##*@}
	host=${host%%/*}
	host=${host%%:*}
	echo "sync-status: no gh or glab for ${host:-origin}; open merge requests not checked"
fi

if [ -n "$num_prefix" ]; then
	echo "sync-status: $header (number, branch, state, labels, files shared with this branch):"
	while IFS=$'\t' read -r num head state labels; do
		[ -n "$num" ] || continue
		shared="-"
		if [ "$head" != "$branch" ] && [ -n "$mine" ] && git rev-parse --verify --quiet "origin/$head" >/dev/null; then
			theirs=$(git diff --name-only "$base...origin/$head" | sort -u)
			overlap=$(comm -12 <(echo "$mine") <(echo "$theirs") | paste -sd, -)
			shared=${overlap:-none}
		fi
		# A branch this one is stacked on shares its files by design, not by accident.
		git merge-base --is-ancestor "origin/$head" HEAD 2>/dev/null && shared="(this branch is stacked on it)"
		[ "$head" = "$branch" ] && shared="(this branch)"
		printf '  %s%s %s [%s] %s: %s\n' "$num_prefix" "$num" "$head" "$state" "${labels:-no label}" "$shared"
	done <<<"$prs"
fi

# On Linux, warn when the rendered Claude settings file is stale. The renderer
# may not exist yet on a branch that adds it.
if [ "$(uname -s 2>/dev/null)" = Linux ] && [ -x "$HOME/dotfiles/scripts/claude-settings-render" ]; then
	"$HOME/dotfiles/scripts/claude-settings-render" --check
fi
exit 0
