#!/bin/bash
# Show, at session start, where this checkout stands against the other machines' work:
# how far the branch is behind origin/main, and which open pull requests touch the same
# files as this branch. Read-only: it fetches, never merges, rebases or pulls.
#
# Why: dotfiles are edited from more than one machine at once. A branch that only one
# machine can see, or two branches changing one file, is how duplicate and contradicting
# work starts. See docs/workflows/multi-machine.md.
#
# Usage: sync-status   (any git repository; prints nothing outside one)
# Exit: always 0, so it can run as a SessionStart hook. Offline or without gh, it says so.

PATH="$PATH:/usr/bin:/bin"
git rev-parse --git-dir >/dev/null 2>&1 || exit 0

if ! timeout 15 git fetch --quiet --prune origin 2>/dev/null; then
	echo "sync-status: fetch failed (offline?); comparing against the last fetch"
fi
branch=$(git branch --show-current)
base=origin/main
git rev-parse --verify --quiet "$base" >/dev/null || exit 0

behind=$(git rev-list --count "HEAD..$base")
echo "sync-status: ${branch:-detached} is $behind commit(s) behind $base"

# This branch's files: committed since it left main, plus uncommitted changes.
mine=$( { git diff --name-only "$base...HEAD"; git diff --name-only HEAD; } | sort -u)

command -v gh >/dev/null || { echo "sync-status: gh missing; open pull requests not checked"; exit 0; }
prs=$(timeout 15 gh pr list --state open --limit 50 \
	--json number,headRefName,isDraft,labels \
	-q '.[] | "\(.number)\t\(.headRefName)\t\(if .isDraft then "draft" else "open" end)\t\([.labels[].name] | join(","))"' 2>/dev/null) ||
	{ echo "sync-status: gh pr list failed; open pull requests not checked"; exit 0; }

echo "sync-status: open pull requests (number, branch, state, labels, files shared with this branch):"
while IFS=$'\t' read -r num head state labels; do
	[ -n "$num" ] || continue
	shared="-"
	if [ "$head" != "$branch" ] && [ -n "$mine" ] && git rev-parse --verify --quiet "origin/$head" >/dev/null; then
		theirs=$(git diff --name-only "$base...origin/$head" | sort -u)
		overlap=$(comm -12 <(echo "$mine") <(echo "$theirs") | paste -sd, -)
		shared=${overlap:-none}
	fi
	# A branch this one is stacked on shares its files by design, not by accident.
	git merge-base --is-ancestor "origin/$head" HEAD 2>/dev/null && shared="(this branch is stacked on it)"
	[ "$head" = "$branch" ] && shared="(this branch)"
	printf '  #%s %s [%s] %s: %s\n' "$num" "$head" "$state" "${labels:-no label}" "$shared"
done <<<"$prs"
exit 0
