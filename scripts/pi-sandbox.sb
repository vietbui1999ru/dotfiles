;; Seatbelt profile for Pi runs, applied by scripts/pi-sandbox through sandbox-exec.
;; Parameters: WT (worktree root), GITDIR (git common dir), JJDIR (jj repo store), TMP ($TMPDIR), HOME.
;; Rules are applied last-match-wins, so each deny block narrows the allow block above it.
;; Findings behind each path: docs/plans/2026-11-11-sandbox-spike.md.
(version 1)
(allow default)

;; Writes: none, then the worktree, temp space and Pi's own runtime state.
(deny file-write*)
(allow file-write*
  (subpath (param "WT"))
  (subpath (param "GITDIR"))
  (subpath (param "JJDIR"))
  (subpath (param "TMP"))
  (subpath "/private/var/folders")
  (subpath "/dev")
  (subpath (string-append (param "HOME") "/.pi"))
  (subpath (string-append (param "HOME") "/.pi-lens"))
  (subpath (string-append (param "HOME") "/.context-mode"))
  (subpath (string-append (param "HOME") "/.local/state/agent-review"))
  (subpath (string-append (param "HOME") "/.local/state/pi-checks"))
  (subpath (string-append (param "HOME") "/.local/state/provenance")))

;; Pi's configuration and installed code, gate state, the focus board, Claude Code's built-in
;; protections and the control sockets are not listed here: scripts/pi-sandbox-policy generates
;; them from Claude's sandbox settings and pi-sandbox appends them after this profile.

;; Harness folders inside a system repo's worktree stay writable until Slice S4 (system-pin)
;; exists; decided 2026-11-11. The main checkout is outside every grant above already.

;; Secrets stay unreadable; scripts/pi-sandbox hands Pi only its provider keys.
(deny file-read* (subpath (string-append (param "HOME") "/secrets")))
