#!/usr/bin/env -S python3 -I
"""pi-sandbox-policy SETTINGS WT GITDIR HOME: print the Seatbelt deny block for a Pi run.

Claude's settings are the single source of protected paths: sandbox.filesystem.denyWrite
and denyRead become (deny file-write*) and (deny file-read*) rules. Claude Code's own
built-in protections (.claude settings, hooks and skills in the worktree; git hooks and
config) and the pueue and herdr control sockets are added here, since settings do not list
them. Any problem (missing file, bad JSON, no sandbox key, a path form this script does
not know) exits 1, and scripts/pi-sandbox refuses the run: a skipped deny would fail open.
"""
import json
import re
import sys

SOCKET_DIRS = ["Library/Application Support/pueue", ".local/state/herdr-core", ".config/herdr-app"]


def die(message):
    print(f"pi-sandbox-policy: {message}", file=sys.stderr)
    sys.exit(1)


def quoted(text):
    if '"' in text or "\\" in text:
        die(f"path holds a quote or backslash: {text!r}")
    return f'"{text}"'


def rule(entry, home):
    """One settings path to one Seatbelt filter."""
    if entry.startswith("**/"):
        tail = entry[3:].rstrip("/")
        if '"' in tail or "*" in tail:
            die(f"unsupported path form in settings: {entry!r}")
        # SBPL's #"..." regex literal takes backslashes as written. Escape only POSIX
        # metacharacters: re.escape also escapes "-", which POSIX leaves undefined.
        escaped = re.sub(r"([.^$+?()\[\]{}|\\])", r"\\\1", tail)
        return f'(regex #"^.*/{escaped}(/.*)?$")'
    if entry.startswith("~/"):
        entry = home + entry[1:]
    if not entry.startswith("/") or "*" in entry.removesuffix("/**"):
        die(f"unsupported path form in settings: {entry!r}")
    return f"(subpath {quoted(entry.removesuffix('/**').rstrip('/') or '/')})"


def main():
    if len(sys.argv) != 5:
        die("usage: pi-sandbox-policy SETTINGS WT GITDIR HOME")
    settings, wt, gitdir, home = sys.argv[1:]
    try:
        with open(settings) as handle:
            sandbox = json.load(handle)["sandbox"]
        filesystem = sandbox.get("filesystem") or {}
        deny_write = list(filesystem.get("denyWrite") or [])
        deny_read = list(filesystem.get("denyRead") or [])
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        die(f"cannot read sandbox settings from {settings}: {error}")
    if not deny_write:
        die(f"no sandbox.filesystem.denyWrite in {settings}")

    write_rules = [rule(entry, home) for entry in deny_write]
    write_rules += [f"(literal {quoted(wt + '/.claude/' + name)})" for name in ("settings.json", "settings.local.json")]
    write_rules += [f"(subpath {quoted(wt + '/.claude/' + name)})" for name in ("hooks", "skills")]
    write_rules += [f"(subpath {quoted(gitdir + '/hooks')})", f"(literal {quoted(gitdir + '/config')})"]
    print(f";; Generated by scripts/pi-sandbox-policy from {settings}")
    print("(deny file-write*\n  " + "\n  ".join(write_rules) + ")")
    if deny_read:
        print("(deny file-read*\n  " + "\n  ".join(rule(entry, home) for entry in deny_read) + ")")
    sockets = [f"(remote unix-socket (subpath {quoted(home + '/' + path)}))" for path in SOCKET_DIRS]
    print("(deny network-outbound\n  " + "\n  ".join(sockets) + ")")


main()
