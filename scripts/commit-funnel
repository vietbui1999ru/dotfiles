#!/usr/bin/env python3
"""commit-funnel: the one checked way for an agent to commit its work.

Usage: commit-funnel [--worktree <path>] -F <message-file> <path>...

Commits only the listed paths, with the message text from the file, in git mode
(no `.jj` at the work-tree root) or in colocated jj mode (`.jj` present, where it
moves the branch bookmark and reattaches git HEAD). Prints `<short-sha>
<subject>` of the new commit. It never pushes, amends, adds unlisted paths or
rewrites the message text: it only appends Agent trailers, one per model whose
provenance-ledger rows cover the committed paths (see scripts/provenance).

Exit codes: 0 committed, 2 refused (numbered steps on stderr), 1 git or jj failed.
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
from collections import OrderedDict
from datetime import datetime, timezone

MESSAGE_LINE_LIMIT = 72
PROTECTED = ("main", "master")
AGENT_PATHS_LIMIT = 10
LEDGER_NOTICE = ("commit-funnel: no provenance ledger rows for the committed paths; "
                 "no Agent: trailers added")
# Where the funnel is and where it was told the session lives; shown on every refusal.
WHERE = {"work-tree root": "", "branch": "", "--worktree": "", "paths": ""}


class Failure(Exception):
    """A git or jj command failed; exit 1."""


class Refusal(Exception):
    """Refuse to commit; exit 2 with a numbered block on stderr."""

    def __init__(self, reason, steps):
        super().__init__(reason)
        self.reason = reason
        self.steps = steps


def git(*args, check=True, env=None):
    r = subprocess.run(["git", *args], capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        raise Failure(r.stderr.strip() or r.stdout.strip() or f"git {' '.join(args)} failed")
    return r


def jj(*args, check=True):
    # --no-pager on every call: nothing may wait on a pager or an editor.
    r = subprocess.run(["jj", "--no-pager", *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Failure(r.stderr.strip() or f"jj {' '.join(args)} failed")
    return r


def refusals(reason, steps):
    raise Refusal(reason, steps)


def check_paths(raw_paths, cwd, root):
    """Return the listed paths as work-tree-relative paths; refuse anything else."""
    if not raw_paths:
        refusals("no paths given", [
            "List the changed paths explicitly, relative to the work-tree root.",
            "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
        ])
    rels = []
    for raw in raw_paths:
        if raw in (".", "-A", "--all") or raw.startswith("-"):
            refusals(f"bad path {raw!r}", [
                f"Name each changed file instead of {raw!r}; never stage the whole tree.",
                "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
            ])
        joined = os.path.normpath(os.path.join(cwd, raw))
        # Resolve the parent, not the path: a symlink is committed as the link itself.
        # realpath on the whole path turned it into its target, so the funnel committed
        # the unchanged target and reported an empty commit as success.
        resolved = os.path.join(os.path.realpath(os.path.dirname(joined)), os.path.basename(joined))
        if os.path.islink(resolved) and not os.path.realpath(resolved).startswith(root + os.sep):
            refusals(f"path {raw!r} is a symlink that resolves outside the work-tree root", [
                f"Only links whose target is under {root} belong to this work tree.",
                "Rerun with paths inside the work-tree root.",
            ])
        if resolved == root:
            refusals(f"path {raw!r} is the work-tree root itself", [
                "Name each changed file instead; never stage the whole tree.",
                "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
            ])
        if not resolved.startswith(root + os.sep):
            refusals(f"path {raw!r} resolves outside the work-tree root", [
                f"Only files under {root} belong to this work tree.",
                "Rerun with paths inside the work-tree root.",
            ])
        rels.append(os.path.relpath(resolved, root))
    return rels


def read_message(message_file, cwd):
    if not message_file:
        refusals("no message file (-F is required)", [
            "Write the commit message to a file, first line at most "
            f"{MESSAGE_LINE_LIMIT} characters.",
            "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
        ])
    path = os.path.join(cwd, message_file)
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        refusals(f"message file {message_file!r} is missing", [
            "Write the message to a file first, then pass that file with -F.",
            "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
        ])
    if not text.strip():
        refusals(f"message file {message_file!r} is empty", [
            "Put a subject line and, if useful, a body in the message file.",
            "Rerun the funnel with that file.",
        ])
    first = text.splitlines()[0]
    if len(first) > MESSAGE_LINE_LIMIT:
        refusals(f"message subject is {len(first)} characters; the limit is "
                 f"{MESSAGE_LINE_LIMIT}", [
                     "Shorten the first line to a subject of at most "
                     f"{MESSAGE_LINE_LIMIT} characters; move the rest to the body.",
                     "Rerun the funnel with the rewritten file.",
                 ])
    return path, text


def protected(branch):
    return branch in PROTECTED


def branch_git():
    r = git("symbolic-ref", "--short", "HEAD", check=False)
    if r.returncode != 0 or not r.stdout.strip():
        refusals("git HEAD is detached; no branch to commit on", [
            "Attach HEAD to a feature branch: git switch -c <branch>",
            "Rerun the funnel on that branch.",
        ])
    return r.stdout.strip()


def branch_jj():
    r = git("symbolic-ref", "--short", "HEAD", check=False)
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()
    found = [n for n in jj("bookmark", "list", "-r", "@-", "-T",
                           'name ++ "\\n"').stdout.splitlines() if n.strip()]
    if len(found) != 1:
        listing = ", ".join(found) if found else "(none)"
        refusals(f"git HEAD is detached and @- has {len(found)} bookmarks: {listing}", [
            "Attach HEAD to the branch you are working on: git switch <branch>",
            f"Or leave exactly one bookmark on @- (found: {listing}).",
            "Rerun the funnel once one branch is unambiguous.",
        ])
    return found[0]


def check_git_index(rels):
    staged = [p for p in git("diff", "--cached", "--name-only", "-z").stdout.split("\0") if p]
    foreign = sorted(set(staged) - set(rels))
    if foreign:
        refusals("paths other than the listed ones are already staged: " +
                 ", ".join(foreign), [
                     "Leave only your listed paths staged; unstage the rest with "
                     "git restore --staged <path>.",
                     "Rerun the funnel with the same paths.",
                 ])


def refuse_unknown(rel, places):
    """Refuse a listed path that is in neither the work tree nor `places`."""
    refusals(f"path {rel!r} is not in the work tree, {places}", [
        "Check the path for typos; list only files you changed or deleted.",
        "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
    ])


def in_index(rel):
    return git("ls-files", "--error-unmatch", "--", rel, check=False).returncode == 0


def in_head(rel):
    return git("cat-file", "-e", f"HEAD:{rel}", check=False).returncode == 0


def stage_git(rels):
    """Stage the listed paths, deletions included; refuse a path that never existed.

    Classify every path before touching the index, so a refusal changes nothing.
    """
    on_disk, removals = [], []
    for rel in rels:
        if os.path.lexists(rel):
            on_disk.append(rel)
        elif in_index(rel):
            removals.append(rel)
        elif not in_head(rel):
            refuse_unknown(rel, "the index or HEAD")
    if on_disk:
        git("add", "--", *on_disk)
    if removals:
        git("rm", "--cached", "-q", "--", *removals)


def ledger_path():
    return os.environ.get("PROVENANCE_LEDGER") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "provenance", "ledger.jsonl")


def parse_ts(text):
    try:
        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (ValueError, TypeError):
        return None


def last_commit_time(rel):
    """Committer date of the last commit touching `rel`, or None when it was never committed."""
    r = git("log", "-1", "--format=%cI", "--", rel, check=False)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        return datetime.fromisoformat(r.stdout.strip()).astimezone(timezone.utc)
    except ValueError:
        return None


def read_ledger():
    """Every well-formed ledger row with a parseable ts; malformed lines are skipped."""
    try:
        with open(ledger_path(), encoding="utf-8") as fh:
            lines = fh.readlines()
    except OSError:
        return []
    rows = []
    for line in lines:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        when = parse_ts(row.get("ts"))
        if when is None:
            continue
        rows.append((when, row))
    return rows


def real(path):
    return os.path.realpath(path)


def covering_rows(rows, root, rels):
    """Map each committed path to the ledger rows that cover it.

    A row counts for a path only when it is newer than that path's last commit, so an
    edit stays attributable until its own path is committed. A run row (path "*") covers
    every path under its cwd; inside a live Pi run (PROVENANCE_SESSION, exported by
    pi-view) that run's row counts for every commit, because it is stamped at run start.
    """
    covered = {rel: [] for rel in rels}
    since = {rel: last_commit_time(rel) for rel in rels}
    live_run = os.environ.get("PROVENANCE_SESSION")
    file_index = {os.path.join(root, rel): rel for rel in rels}

    def fresh(when, rel):
        return since[rel] is None or when > since[rel]

    for when, row in rows:
        cwd = row.get("cwd")
        if not isinstance(cwd, str) or cwd == "unknown":
            continue
        cwd_real = real(cwd)
        if row.get("path") == "*":
            if cwd_real != root and not cwd_real.startswith(root + os.sep):
                continue
            in_run = bool(live_run) and row.get("session") == live_run
            for rel in rels:
                if in_run or fresh(when, rel):
                    covered[rel].append(row)
            continue
        path = row.get("path")
        if not isinstance(path, str):
            continue
        target = real(path if os.path.isabs(path) else os.path.join(cwd_real, path))
        rel = file_index.get(target)
        if rel is not None and fresh(when, rel):
            covered[rel].append(row)
    return covered


def compress_paths(paths):
    """Return the path list for an Agent-Paths trailer, collapsing to directories past the limit."""
    paths = sorted(paths)
    if len(paths) <= AGENT_PATHS_LIMIT:
        return paths
    dirs = sorted({os.path.dirname(p) + "/" if "/" in p else p for p in paths})
    if len(dirs) <= AGENT_PATHS_LIMIT:
        return dirs
    return sorted({p.split("/", 1)[0] + "/" if "/" in p else p for p in paths})


def provenance_trailers(root, rels):
    """Return a list of (key, value) trailers for the committed paths, one set per model."""
    covered = covering_rows(read_ledger(), root, rels)
    per_model = OrderedDict()
    for rel in rels:
        for row in covered[rel]:
            model = row.get("model") or "unknown"
            slot = per_model.setdefault(model, {"paths": set(), "rows": []})
            slot["paths"].add(rel)
            slot["rows"].append(row)
    trailers = []
    for model, slot in per_model.items():
        rows = slot["rows"]

        def distinct(field):
            values = sorted({str(r.get(field) or "unknown") for r in rows})
            return ",".join(values)

        head = (f"{model} effort={distinct('effort')} role={distinct('role')} "
                f"harness={distinct('harness')}/{distinct('harness_version')} "
                f"session={distinct('session')} paths={len(slot['paths'])}")
        trailers.append(("Agent", head))
        trailers.append(("Agent-Paths", model + " " + ", ".join(compress_paths(slot["paths"]))))
    return trailers


def with_trailers(text, trailers):
    """Append trailers with git interpret-trailers, which keeps existing ones and de-duplicates."""
    args = ["git", "interpret-trailers", "--if-exists", "addIfDifferent"]
    for key, value in trailers:
        args += ["--trailer", f"{key}: {value}"]
    r = subprocess.run(args, input=text, capture_output=True, text=True)
    if r.returncode != 0:
        raise Failure(r.stderr.strip() or "git interpret-trailers failed")
    return r.stdout


def message_with_trailers(root, rels, text):
    """Return the message text with provenance trailers, or None when no rows cover the paths."""
    trailers = provenance_trailers(root, rels)
    if not trailers:
        return None
    return with_trailers(text, trailers)


def commit_git(rels, message_path, text, root):
    check_git_index(rels)
    stage_git(rels)
    final = message_with_trailers(root, rels, text)
    if final is None:
        print(LEDGER_NOTICE, file=sys.stderr)
        final = text
    commit_path = message_path
    if final != text:
        fd, commit_path = tempfile.mkstemp(prefix="commit-funnel-", suffix=".msg")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(final)
    try:
        # COMMIT_FUNNEL=1 lets the reference-transaction hook allow this one ref update.
        git("commit", "-F", commit_path, env={**os.environ, "COMMIT_FUNNEL": "1"})
    finally:
        if commit_path != message_path:
            os.unlink(commit_path)
    subject = git("log", "-1", "--format=%h %s").stdout.strip()
    print(subject)


def fileset(rel):
    """Quote a root-relative path as a literal jj fileset; bare names like `c(1).txt` do not parse."""
    return 'root:"' + rel.replace("\\", "\\\\").replace('"', '\\"') + '"'


def jj_in_parent(rel):
    return bool(jj("file", "list", "-r", "@-", fileset(rel)).stdout.strip())


def commit_jj(rels, text, branch, root):
    sets = [fileset(r) for r in rels]
    # jj snapshots deletions of tracked files itself: track only what is on disk.
    for rel in rels:
        if not os.path.lexists(rel) and not jj_in_parent(rel):
            refuse_unknown(rel, "nor the parent commit")
    on_disk = [fileset(r) for r in rels if os.path.lexists(r)]
    if on_disk:
        jj("file", "track", *on_disk)
    final = message_with_trailers(root, rels, text)
    if final is None:
        print(LEDGER_NOTICE, file=sys.stderr)
        final = text
    jj("commit", "-m", final, *sets)
    jj("bookmark", "move", branch, "--to", "@-")
    git("switch", branch)
    subject = jj("log", "--no-graph", "-r", "@-", "-T",
                 'commit_id.short() ++ " " ++ description.first_line() ++ "\\n"').stdout.strip()
    print(subject)


def show(field, value):
    WHERE[field] = value


def run(args):
    cwd = os.getcwd()
    if args.paths:
        show("paths", " ".join(args.paths))
    if args.worktree:
        show("--worktree", os.path.realpath(os.path.join(cwd, args.worktree)))
    r = git("rev-parse", "--show-toplevel", check=False)
    if r.returncode != 0 or not r.stdout.strip():
        refusals("not inside a git work tree", [
            "Work inside your session worktree before committing.",
            "Rerun: commit-funnel --worktree <session worktree> -F <message file> <path>...",
        ])
    root = os.path.realpath(r.stdout.strip())
    show("work-tree root", root)
    if args.worktree:
        told = os.path.realpath(os.path.join(cwd, args.worktree))
        if told != root:
            listed = " ".join(args.paths) if args.paths else "(none)"
            refusals("wrong checkout: you are not in your session worktree", [
                f"Do not commit here. You are in {root}.",
                f"Tell the user: you are in {root}, your session worktree is {told}, "
                f"your changed paths are {listed}.",
                f"Wait for the user to move the changes into {told}; touching {root} is "
                "outside this session's isolation.",
            ])
    os.chdir(root)
    jj_mode = os.path.isdir(os.path.join(root, ".jj"))
    branch = branch_jj() if jj_mode else branch_git()
    show("branch", branch)
    if protected(branch):
        refusals(f"branch {branch} is protected", [
            "Do not commit on main or master.",
            "Cut a feature branch (git switch -c <branch>) and rerun the funnel there.",
        ])
    rels = check_paths(args.paths, cwd, root)
    message_path, text = read_message(args.message_file, cwd)
    if jj_mode:
        commit_jj(rels, text, branch, root)
    else:
        commit_git(rels, message_path, text, root)


def main():
    ap = argparse.ArgumentParser(prog="commit-funnel", allow_abbrev=False)
    ap.add_argument("--worktree", metavar="PATH",
                    help="the session's worktree; a different work-tree root is a refusal")
    ap.add_argument("-F", dest="message_file", metavar="FILE",
                    help="file holding the commit message")
    ap.add_argument("-A", dest="all_short", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--all", dest="all_long", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("paths", nargs="*", metavar="PATH")
    args = ap.parse_args()
    try:
        if args.all_short:
            args.paths = ["-A", *args.paths]
        if args.all_long:
            args.paths = ["--all", *args.paths]
        run(args)
    except Refusal as e:
        print("commit-funnel: refused", file=sys.stderr)
        print(f"  reason: {e.reason}", file=sys.stderr)
        for label, value in WHERE.items():
            if value:
                print(f"  {label}: {value}", file=sys.stderr)
        print(file=sys.stderr)
        for i, step in enumerate(e.steps, 1):
            print(f"{i}. {step}", file=sys.stderr)
        return 2
    except Failure as e:
        print(f"commit-funnel: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
