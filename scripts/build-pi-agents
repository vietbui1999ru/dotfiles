#!/usr/bin/env zsh
# build-pi-agents — generate Pi's lean AGENTS.md from one source.
#
# Pi's harness is narrower than Claude's: it implements and does local retrieval.
# Its AGENTS.md is shared/pi-role.md plus only the shared sections Pi needs, taken
# verbatim from shared/research-tool-routing.md, so the two cannot drift.
#
# Usage: scripts/build-pi-agents          # write pi/.pi/agent/AGENTS.md
#        scripts/build-pi-agents --check  # exit 1 when the committed file is stale
set -eu

root=${0:A:h:h}
role=$root/shared/pi-role.md
routing=$root/shared/research-tool-routing.md
out=$root/pi/.pi/agent/AGENTS.md

# Sections copied from the shared routing file. The rest of that file is Claude's
# research routing (which tools to query), and stays out of Pi's instructions.
headings=(
	'Post-run Verification'
	'Shell Tools — prefer the modern CLI'
	'Spec loop'
	'Code discipline: YAGNI'
	'Git history'
	'Repo tooling: mise'
)

# section <heading>: the body of one `## <heading>` block, trailing blanks trimmed.
section() {
	awk -v want="## $1" '
		$0 == want { copying = 1 }
		copying && /^## / && $0 != want { exit }
		copying { lines[n++] = $0 }
		END {
			last = n - 1
			while (last >= 0 && lines[last] ~ /^[[:space:]]*$/) last--
			for (i = 0; i <= last; i++) print lines[i]
		}
	' "$routing"
}

build() {
	print -r -- '# Pi Agent Instructions'
	print -r --
	print -r -- '# Generated by scripts/build-pi-agents from shared/pi-role.md and named'
	print -r -- '# sections of shared/research-tool-routing.md. Do not edit this file:'
	print -r -- '# edit those sources and run scripts/build-pi-agents.'
	print -r --
	cat "$role"
	local heading
	for heading in $headings; do
		print -r --
		section "$heading"
	done
}

if [[ ${1:-} == --check ]]; then
	fresh=$(mktemp "${TMPDIR:-/tmp}/pi-agents.XXXXXX") || exit 1
	trap 'rm -f "$fresh"' EXIT
	build >|"$fresh"
	if diff -u "$out" "$fresh" >&2; then
		print -r -- 'pi/.pi/agent/AGENTS.md is up to date'
		exit 0
	fi
	print -r -- 'pi/.pi/agent/AGENTS.md is stale: run scripts/build-pi-agents' >&2
	exit 1
fi

fresh=$(mktemp "${TMPDIR:-/tmp}/pi-agents.XXXXXX") || exit 1
trap 'rm -f "$fresh"' EXIT
build >|"$fresh"
rm -f -- "$out"
mv -- "$fresh" "$out"
print -r -- 'wrote pi/.pi/agent/AGENTS.md'
