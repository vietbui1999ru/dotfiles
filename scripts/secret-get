#!/bin/sh
# Print the value of one named key from the secrets file. Never sources or executes it.
#
# Why: ~/secrets/.env is a plain KEY=value list. Sourcing it exports every key into the
# caller, and a process started before a rotation keeps the old value. This reads ONLY the
# named key, so each tool loads just the keys it needs (see with-secrets).
#
# Usage: secret-get NAME
# Exit: 0 value printed; 1 NAME not found (stderr names NAME only); 2 file or folder mode
# is too loose (stderr gives the reason, never a value).
# Override: SECRETS_ENV (secrets file path).

# A harness may launch with a sparse PATH; the lookup below needs sed, tail, tr and stat.
PATH="$PATH:/usr/bin:/bin"

if [ "$#" -ne 1 ]; then
	echo "usage: secret-get NAME" >&2
	exit 1
fi
name="$1"
case "$name" in
	*[!A-Za-z0-9_]*|'') echo "secret-get: invalid name" >&2; exit 1 ;;
esac
env_file="${SECRETS_ENV:-$HOME/secrets/.env}"

if [ ! -r "$env_file" ]; then
	echo "secret-get: cannot read secrets file" >&2
	exit 1
fi

# Octal permission bits: GNU/Linux stat takes -c, macOS stat takes -f.
mode_of() {
	if stat -c %a "$1" >/dev/null 2>&1; then
		stat -c %a "$1"
	else
		stat -f %Lp "$1"
	fi
}

file_mode=$(mode_of "$env_file")
dir_mode=$(mode_of "$(dirname "$env_file")")
case "$file_mode" in
	''|*[!0-7]*) echo "secret-get: refusing: secrets file mode is not an octal mode" >&2; exit 2 ;;
esac
case "$dir_mode" in
	''|*[!0-7]*) echo "secret-get: refusing: secrets folder mode is not an octal mode" >&2; exit 2 ;;
esac
if [ "$file_mode" != "600" ]; then
	echo "secret-get: refusing: secrets file mode is $file_mode, expected 600" >&2
	exit 2
fi
if [ "$dir_mode" != "700" ]; then
	echo "secret-get: refusing: secrets folder mode is $dir_mode, expected 700" >&2
	exit 2
fi

# Last definition wins; optional export prefix; single or double quotes stripped; CR removed.
value=$(sed -n -E "s/^(export[[:space:]]+)?${name}=//p" "$env_file" | tail -n 1 | tr -d '\r' | sed -E "s/^[\"']//; s/[\"']\$//")
if [ -z "$value" ] && ! sed -n -E "s/^(export[[:space:]]+)?${name}=//p" "$env_file" | grep -q .; then
	echo "secret-get: $name not found" >&2
	exit 1
fi
printf '%s\n' "$value"
