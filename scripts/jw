#!/usr/bin/env bash
# jw: create and remove colocated jj workspaces under .claude/worktrees/.
#
#   jw new <branch>   create the workspace, attach HEAD to <branch>, print its path
#   jw rm <name>      forget the workspace and remove its directory (never the branch)
#   jw ls             list workspaces, one per line: name, branch, sweep|keep, reason
#   jw sweep [--apply] preview the sweepable workspaces; --apply removes them (see below)
#   jw bg <branch> <prompt>
#                     ensure the workspace exists, then start `claude --bg <prompt>` in it
#
# `jw rm` deletes known caches (`__pycache__/`, `.ruff_cache/`), archives known agent
# records under $XDG_STATE_HOME/jw-archive/<repo>/<name>-<timestamp>/ (default
# ~/.local/state), and refuses anything else it finds gitignored. Archives older than
# 14 days are pruned after a successful removal.
#
# jw is exempt from Claude's Bash sandbox by absolute path, so it runs unsandboxed
# and these argument checks are the security boundary: branch and workspace names
# are allow-listed, the prompt stays one argv word, and `--full` is refused.
#
# Runnable from any checkout of the repo: the primary checkout is found from
# `git rev-parse --git-common-dir`. See docs/workflows/jj-workspaces-plan.md (M1).
set -euo pipefail

PROTECTED=(main master)
NAME_LIMIT=16

# Gitignored paths `jw rm` may delete. These are regenerable caches.
DELETE_IGNORED=(
  '__pycache__'   # Python bytecode, recreated on the next run
  '.ruff_cache'   # Ruff's cache, recreated on the next run
)

# Gitignored paths `jw rm` archives instead of deleting, because they are records.
ARCHIVE_IGNORED=(
  '.pi/'                 # .pi/agent-review/decisions: the record of approved Pi runs
  '.agents/events.jsonl' # the workspace's agent event log
  '.agents/sessions/'    # saved session notes (auto-clear and save-session write them)
  '.pi-lens-probe-home/' # pi-lens logs from the Pi runs in this workspace
  '.serena/'             # Serena's project folder, kept until inspected
)

# Archive folders older than this many days are pruned after a successful removal.
ARCHIVE_RETENTION_DAYS=14
BRANCH_RE='^(feat|fix|docs|chore|refactor|test|perf|ci)/[a-z0-9][a-z0-9-]*$'
WS_RE='^[a-z0-9][a-z0-9-]*$'

usage() {
  cat >&2 <<'EOF'
usage: jw new <branch>
       jw rm <name>
       jw ls
       jw sweep [--apply]
       jw bg <branch> <prompt>
EOF
  exit 2
}

die() {
  printf 'jw: %s\n' "$*" >&2
  exit 2
}

primary_checkout() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not inside a git work tree"
  dirname "$common"
}

# The path without its trailing slash, as a directory entry would be named.
entry_name() {
  printf '%s\n' "${1%/}"
}

is_delete_entry() {
  local path name
  path=$(entry_name "$1")
  name=${path##*/}
  local allowed
  for allowed in "${DELETE_IGNORED[@]}"; do
    [ "$name" != "$allowed" ] || return 0
  done
  return 1
}

is_archive_entry() {
  local path=$1 allowed
  for allowed in "${ARCHIVE_IGNORED[@]}"; do
    [ "$path" != "$allowed" ] || return 0
    case $allowed in
      */)
        case $path in
          "$allowed"*) return 0 ;;
        esac
        ;;
    esac
  done
  return 1
}

archive_root() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/jw-archive/$(basename -- "$1")"
}

prune_archives() {
  local root=$1
  [ -d "$root" ] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -type d -mtime +"$ARCHIVE_RETENTION_DAYS" \
    -exec rm -rf -- {} + \
    || printf 'jw: warning: could not prune old archives under %s\n' "$root" >&2
}

# The workspace name is the branch without its type prefix: feat/jj-ws -> jj-ws.
workspace_name() {
  printf '%s\n' "${1#*/}"
}

cmd_new() {
  local branch=${1:-} name primary dir protected
  [ -n "$branch" ] || usage
  for protected in "${PROTECTED[@]}"; do
    [ "$branch" != "$protected" ] || die "refusing protected branch '$branch'"
  done
  [ "${#branch}" -le "$NAME_LIMIT" ] \
    || die "branch '$branch' is ${#branch} characters; the limit is $NAME_LIMIT"
  [[ $branch =~ $BRANCH_RE ]] \
    || die "branch '$branch' must look like <type>/<name>: type one of feat fix docs chore refactor test perf ci, name in [a-z0-9-]"
  name=$(workspace_name "$branch")
  primary=$(primary_checkout)
  dir="$primary/.claude/worktrees/$name"
  [ ! -e "$dir" ] || die "target directory already exists: $dir"

  git -C "$primary" fetch origin main || die "git fetch origin main failed in $primary"
  mkdir -p "$primary/.claude/worktrees"
  (cd "$primary" && jj workspace add --colocate --name "$name" -r main@origin \
    ".claude/worktrees/$name") || die "jj workspace add failed"
  (cd "$dir" && jj bookmark create "$branch" -r @-) || die "jj bookmark create failed"
  (cd "$dir" && git switch "$branch") || die "git switch $branch failed"

  printf '%s\n' "$dir"
}

# Shared by `jw rm` and `jw ls`, so the two cannot disagree about a workspace.
# Sets WS_DIRTY (uncommitted changes) and WS_UNKNOWN (gitignored entries that
# removal would delete but that are neither a known cache nor a known record).
classify_workspace() {
  local dir=$1 entries line path
  WS_DIRTY=$(git -C "$dir" status --porcelain) || return 1
  WS_UNKNOWN=()
  entries=$(git -C "$dir" status --porcelain --ignored | grep '^!! ' | grep -v '^!! \.jj/$' || true)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=${line#!! }
    path=$(entry_name "$path")
    if is_delete_entry "$path" || is_archive_entry "$path"; then
      continue
    fi
    WS_UNKNOWN+=("$path")
  done <<< "$entries"
}

cmd_rm() {
  local name=${1:-} primary dir real entries dirty line path branch commit
  local archive_repo archive_dir
  local -a unknown=() delete=() archive=()
  [ -n "$name" ] || usage
  # The name must be one plain path component: "../x" or "a/b" resolve outside
  # the workspaces directory and would point the removal at another checkout.
  [[ $name =~ $WS_RE ]] || die "workspace name '$name' must match [a-z0-9][a-z0-9-]*"
  primary=$(primary_checkout)
  dir="$primary/.claude/worktrees/$name"
  [ -d "$dir" ] || die "no workspace named '$name' at $dir"

  dirty=$(git -C "$dir" status --porcelain) \
    || die "git status failed in $dir"
  [ -z "$dirty" ] \
    || die "workspace '$name' has uncommitted changes; commit or discard them first"

  # Gitignored content (caches, agent records) is not in git. Delete the known
  # caches, archive the known records, and refuse anything else so the human
  # decides. .jj is jj's own state.
  entries=$(git -C "$dir" status --porcelain --ignored | grep '^!! ' | grep -v '^!! \.jj/$' || true)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=${line#!! }
    if is_delete_entry "$path"; then
      delete+=("$path")
    elif is_archive_entry "$path"; then
      archive+=("$path")
    else
      unknown+=("$path")
    fi
  done <<< "$entries"

  if [ ${#unknown[@]} -gt 0 ]; then
    printf "jw: workspace '%s' holds gitignored content that removal would delete; remove or move it first:\n" "$name" >&2
    printf '!! %s\n' "${unknown[@]}" >&2
    exit 2
  fi

  branch=$(git -C "$dir" branch --show-current)
  commit=$(git -C "$dir" rev-parse HEAD)

  # The length guard is for bash 3.2 (macOS /bin/bash), where expanding an empty
  # array under `set -u` is an unbound-variable error.
  if [ ${#delete[@]} -gt 0 ]; then
    for path in "${delete[@]}"; do
      rm -rf -- "${dir:?}/${path:?}"
    done
  fi

  if [ ${#archive[@]} -gt 0 ]; then
    archive_repo=$(archive_root "$primary")
    archive_dir="$archive_repo/$name-$(date +%Y%m%d-%H%M%S)"
    mkdir -p -- "$archive_repo"
    mkdir -- "$archive_dir"
    chmod 700 "$archive_dir"
    {
      printf 'branch: %s\n' "$branch"
      printf 'commit: %s\n' "$commit"
      printf 'date: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    } >"$archive_dir/jw-meta.txt"
    for path in "${archive[@]}"; do
      mkdir -p -- "$(dirname -- "$archive_dir/$path")"
      mv -- "$dir/$path" "$archive_dir/$path"
    done
    printf 'jw: archived %s entries to %s\n' "${#archive[@]}" "$archive_dir" >&2
  fi

  real=$(cd "$dir" && pwd -P)
  # Git goes first. `jj workspace forget` also drops the git worktree registration,
  # after which `git worktree remove` cannot reach the files and leaves them behind.
  if git -C "$primary" worktree list --porcelain | grep -qxF "worktree $real"; then
    git -C "$primary" worktree remove "$dir" \
      || die "git worktree remove failed; the worktree is still at $dir"
  fi
  (cd "$primary" && jj workspace forget "$name") || die "jj workspace forget failed"
  # jj leaves the workspace directory behind, holding only its own .jj state.
  # Remove just that, then rmdir the directory, so anything unexpected fails loudly.
  if [ -e "$dir/.jj" ]; then
    rm -rf -- "$dir/.jj"
  fi
  if [ -d "$dir" ]; then
    rmdir -- "$dir" || die "directory not empty after removal: $dir"
  fi
  git -C "$primary" worktree list --porcelain | grep -qxF "worktree $real" \
    && die "git worktree entry survived removal: $real"

  prune_archives "$(archive_root "$primary")"

  printf '%s\n' "$dir"
}

# Merged-PR map for the primary checkout: lines of "<branch> <oid>". Refuses
# without jq. A failed `gh` leaves MERGED_OK=0, which marks every workspace merged?.
load_merged() {
  local primary=$1 json
  MERGED_MAP=""
  MERGED_OK=0
  command -v jq >/dev/null || die "jq is required for jw ls and jw sweep"
  json=$(cd "$primary" && gh pr list --state merged --limit 200 --json headRefName,headRefOid 2>/dev/null) \
    || return 0
  MERGED_MAP=$(printf '%s' "$json" | jq -r '.[] | "\(.headRefName) \(.headRefOid)"') \
    || { MERGED_MAP=""; return 0; }
  MERGED_OK=1
}

# Live: a claude, pi or node process has its cwd inside the workspace. lsof exit 1
# means no match; any other failure makes the answer unknown (LIVE_OK=0).
load_live_cwds() {
  local out rc
  LIVE_CWDS=""
  LIVE_OK=1
  command -v lsof >/dev/null || { LIVE_OK=0; return 0; }
  out=$(lsof -a -d cwd -c claude -c pi -c node -Fn 2>/dev/null) && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    LIVE_CWDS=$(printf '%s\n' "$out" | sed -n 's/^n//p')
  elif [ "$rc" -eq 1 ]; then
    LIVE_CWDS=""
  else
    LIVE_OK=0
  fi
}

# Sets SWEEP_STATE (sweep|keep) and SWEEP_REASON for one workspace directory.
# The first rule it fails names the reason. Order matches the plan: branch,
# merged, head, live, clean tree, ignored content.
sweep_state() {
  local name=$1 dir=$2 branch head oid real
  SWEEP_STATE=keep
  # Without the PR list no workspace can be proven merged, so gh failure keeps all.
  if [ "$MERGED_OK" -ne 1 ]; then SWEEP_REASON="merged?"; return; fi
  branch=$(git -C "$dir" branch --show-current)
  if [ -z "$branch" ]; then SWEEP_REASON=detached; return; fi
  for protected in "${PROTECTED[@]}"; do
    [ "$branch" != "$protected" ] || { SWEEP_REASON="protected branch"; return; }
  done
  oid=$(printf '%s\n' "$MERGED_MAP" | awk -v b="$branch" '$1==b{print $2; exit}')
  if [ -z "$oid" ]; then SWEEP_REASON="not merged"; return; fi
  head=$(git -C "$dir" rev-parse HEAD)
  if [ "$head" != "$oid" ]; then SWEEP_REASON="newer commits"; return; fi
  if [ "$LIVE_OK" -ne 1 ]; then SWEEP_REASON="live?"; return; fi
  real=$(cd "$dir" && pwd -P)
  if printf '%s\n' "$LIVE_CWDS" | grep -qxF "$real" \
     || printf '%s\n' "$LIVE_CWDS" | grep -q "^$real/"; then
    SWEEP_REASON=live; return
  fi
  classify_workspace "$dir" || { SWEEP_REASON="status failed"; return; }
  if [ -n "$WS_DIRTY" ]; then SWEEP_REASON=uncommitted; return; fi
  if [ ${#WS_UNKNOWN[@]} -gt 0 ]; then
    SWEEP_REASON="unknown ignored: ${WS_UNKNOWN[0]}"; return
  fi
  SWEEP_STATE=sweep
  SWEEP_REASON=ok
}

# One line per workspace directory, sorted by name: name, branch, state, reason.
cmd_ls() {
  [ $# -eq 0 ] || usage
  local primary base dir name branch
  primary=$(primary_checkout)
  base="$primary/.claude/worktrees"
  load_merged "$primary"
  load_live_cwds
  [ -d "$base" ] || return 0
  for dir in "$base"/*/; do
    [ -d "$dir" ] || continue
    dir=${dir%/}
    name=${dir##*/}
    branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)
    [ -n "$branch" ] || branch=-
    sweep_state "$name" "$dir"
    printf '%s\t%s\t%s\t%s\n' "$name" "$branch" "$SWEEP_STATE" "$SWEEP_REASON"
  done
}

# Preview by default; --apply recomputes the list and removes each sweep
# workspace with the same path as `jw rm`. One failure does not stop the rest.
cmd_sweep() {
  local apply=0 primary base dir name line state
  local -a sweep=()
  case ${1:-} in
    '') ;;
    --apply) [ $# -eq 1 ] || usage; apply=1 ;;
    *) usage ;;
  esac
  primary=$(primary_checkout)
  base="$primary/.claude/worktrees"
  while IFS=$'\t' read -r name _ state _; do
    [ "$state" = sweep ] && sweep+=("$name")
  done < <(cmd_ls)
  if [ "$apply" -eq 0 ]; then
    for name in "${sweep[@]+"${sweep[@]}"}"; do
      printf '%s\n' "$name"
    done
    printf 'jw: %s workspaces would be removed; rerun with --apply to remove them\n' "${#sweep[@]}" >&2
    return 0
  fi
  local failed=0
  for name in "${sweep[@]+"${sweep[@]}"}"; do
    if cmd_rm "$name"; then
      printf 'removed %s\n' "$name"
    else
      printf 'FAILED %s\n' "$name" >&2
      failed=1
    fi
  done
  [ "$failed" -eq 0 ] || exit 2
}

# bg: the prompt is passed to claude as one argv word, never through a shell.
cmd_bg() {
  [ $# -eq 2 ] || usage
  local branch=$1 prompt=$2 dir current
  [ -n "$prompt" ] || die "empty prompt"
  # jw runs unsandboxed: a prompt like --settings=... would reach claude as an option.
  case $prompt in -*) die "prompt must not start with '-'" ;; esac
  [[ $branch =~ $BRANCH_RE ]] || die "branch '$branch' must look like <type>/<name>"
  dir="$(primary_checkout)/.claude/worktrees/$(workspace_name "$branch")"
  if [ -d "$dir" ]; then
    current=$(git -C "$dir" branch --show-current 2>/dev/null || true)
    [ "$current" = "$branch" ] \
      || die "workspace $dir is on '${current:-detached}', not '$branch'"
  else
    cmd_new "$branch" >/dev/null
  fi
  cd "$dir" || die "cannot enter $dir"
  # Same as the zsh claude() wrapper: only the two optional MCP keys, when the
  # secrets file exists. The bg session sandboxes its own Bash.
  if [ -r "${SECRETS_ENV:-$HOME/secrets/.env}" ]; then
    exec "$HOME/dotfiles/scripts/with-secrets" --optional CONTEXT7_API_KEY EXCALIDRAW_API_KEY \
      -- claude --bg "$prompt"
  fi
  exec claude --bg "$prompt"
}

# Full mode (S4) is not built yet; refuse it everywhere until it is.
for arg in "$@"; do
  case $arg in
    --full*) die "full mode is not available; run jw without --full" ;;
  esac
done

case ${1:-} in
  new) shift; cmd_new "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  sweep) shift; cmd_sweep "$@" ;;
  bg) shift; cmd_bg "$@" ;;
  *) usage ;;
esac
