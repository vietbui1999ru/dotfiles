#!/bin/sh
# Run a command with only the named keys added to its environment, from the secrets file.
#
# Why: a tool that needs one key should get that key and no other. Sourcing ~/secrets/.env
# into a shell exports every key into every child. This resolves each NAME through
# secret-get (which never executes the file) and execs the command with just those names.
#
# Usage: with-secrets [--optional] NAME... -- cmd args
# Exit: 1 usage error; otherwise the secret-get code when a key is missing (no exec), or the
# command's own exit status.
# Override: SECRETS_ENV is passed through to secret-get.
#
# --optional: a NAME that is not in the file is skipped instead of stopping the command. For a key
# only an optional integration needs, such as an MCP server's token, an absent key must cost that
# integration and not the client. A file or folder mode that is too loose stays fatal even then:
# that is a security error, not a missing key.

# A harness may launch with a sparse PATH; env and the helper live in /usr/bin and /bin.
PATH="$PATH:/usr/bin:/bin"

here=$(cd "$(dirname "$0")" && pwd)

optional=0
if [ "$1" = "--optional" ]; then
	optional=1
	shift
fi

names=""
while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
	names="$names $1"
	shift
done
if [ "$#" -eq 0 ] || [ -z "$names" ]; then
	echo "usage: with-secrets [--optional] NAME... -- cmd args" >&2
	exit 1
fi
shift # drop --
if [ "$#" -eq 0 ]; then
	echo "usage: with-secrets [--optional] NAME... -- cmd args" >&2
	exit 1
fi

# Resolve every key before exec, so a missing required one stops the command from running.
# Keys are exported in this shell, never passed as `env NAME=value` arguments: argv is
# visible to every local process through ps, the environment is not. secret-get has
# already rejected any NAME that is not [A-Za-z0-9_], so the export is safe.
for name in $names; do
	value=$("$here/secret-get" "$name")
	status=$?
	if [ "$status" -ne 0 ]; then
		if [ "$optional" -eq 1 ] && [ "$status" -eq 1 ]; then
			continue
		fi
		exit "$status"
	fi
	export "$name=$value"
done
exec "$@"
