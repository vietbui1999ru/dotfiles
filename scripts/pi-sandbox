#!/usr/bin/env zsh
# pi-sandbox <command...>: run a Pi command under the Seatbelt profile scripts/pi-sandbox.sb.
# scripts/pi-view puts this in front of every dispatch, including --tui runs in a herdr pane.
# It never falls back to an unsandboxed run: no sandbox-exec or no profile is a refusal.
set -u

script_dir=${${0:A}:h}
profile=$script_dir/pi-sandbox.sb
(( $# )) || { print -u2 -- 'usage: pi-sandbox <command...>'; exit 2 }
(( $+commands[sandbox-exec] )) || { print -u2 -- 'pi-sandbox: sandbox-exec not found; refusing to run unsandboxed'; exit 1 }
[[ -r $profile ]] || { print -u2 -- "pi-sandbox: profile missing: $profile; refusing to run unsandboxed"; exit 1 }

# The worktree and the stores its git and jj write to, all outside the worktree in a linked checkout.
wt=${PWD:A} gitdir=${PWD:A} jjdir=${PWD:A}/.jj
if top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
  wt=${top:A}
  gitdir=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir)
  gitdir=${gitdir:A}
  jjdir=$wt/.jj
  # A secondary jj workspace points at the shared store through .jj/repo.
  [[ -f $wt/.jj/repo ]] && jjdir=$wt/.jj/$(<$wt/.jj/repo)
  jjdir=${jjdir:A}
  # .git and .jj/repo are files in the worktree, which a previous Pi run could write. Grant
  # their stores only when both belong to this worktree's own repo, or refuse the run.
  repo_root=${gitdir:h}
  [[ ${gitdir:t} == .git && -d $gitdir/objects && -f $gitdir/HEAD ]] \
    || { print -u2 -- "pi-sandbox: unexpected git common dir: $gitdir; refusing"; exit 1 }
  if [[ $wt != $repo_root ]]; then
    linked=0
    # git may record the path relative to the worktrees/<name> folder (worktree.useRelativePaths).
    for f in $gitdir/worktrees/*/gitdir(N); do
      recorded=$(<$f); [[ $recorded == /* ]] || recorded=${f:h}/$recorded
      [[ ${recorded:A} == ${wt}/.git ]] && linked=1
    done
    (( linked )) || { print -u2 -- "pi-sandbox: $wt is not a worktree of $repo_root; refusing"; exit 1 }
  fi
  if [[ -e $wt/.jj ]] && [[ $jjdir != $repo_root/.jj/repo && $jjdir != $wt/.jj ]]; then
    print -u2 -- "pi-sandbox: jj store $jjdir is outside $repo_root; refusing"; exit 1
  fi
  # The agent-review extension watches decisions/; the profile lets it read but not create it.
  mkdir -p -- "$wt/.pi/agent-review/decisions"
fi

# Provider keys come from the secrets file here, outside the sandbox, one at a time;
# inside it ~/secrets is unreadable, so Pi sees only these keys.
# Name in the secrets file -> the variable Pi reads (OPENCODE_API_KEY serves opencode-go).
typeset -A pi_keys=(OPENCODE_GO_API_KEY_PI_QUEUES OPENCODE_API_KEY CONTEXT7_API_KEY CONTEXT7_API_KEY)
for key_name env_name in ${(kv)pi_keys}; do
  if key_value=$(SECRETS_ENV=${PI_VIEW_SECRETS:-$HOME/secrets/.env} "$script_dir/secret-get" "$key_name" 2>/dev/null); then
    export "$env_name=$key_value"
  fi
done

# Protected paths come from Claude's sandbox settings (scripts/pi-sandbox-policy), appended
# after the base profile so they win. No usable settings means no run, never a weaker one.
settings=${PI_SANDBOX_SETTINGS:-$HOME/.claude/settings.json}
policy_gitdir=$gitdir
[[ -n ${top:-} ]] || policy_gitdir=$wt/.git
policy=$("$script_dir/pi-sandbox-policy" "$settings" "$wt" "$policy_gitdir" "$HOME") \
  || { print -u2 -- "pi-sandbox: no usable sandbox policy in $settings; refusing to run unsandboxed"; exit 1 }

exec sandbox-exec -p "$(<$profile)
$policy" -D WT="$wt" -D GITDIR="$gitdir" -D JJDIR="$jjdir" \
  -D TMP="${${TMPDIR:-/tmp}:A}" -D HOME="$HOME" "$@"
