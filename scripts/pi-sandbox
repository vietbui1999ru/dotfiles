#!/usr/bin/env zsh
# pi-sandbox <command...>: run a Pi command under the Seatbelt profile scripts/pi-sandbox.sb.
# scripts/pi-view puts this in front of every dispatch, including --tui runs in a herdr pane.
# It never falls back to an unsandboxed run: no sandbox-exec or no profile is a refusal.
set -u

script_dir=${${0:A}:h}
profile=$script_dir/pi-sandbox.sb
(( $# )) || { print -u2 -- 'usage: pi-sandbox <command...>'; exit 2 }
(( $+commands[sandbox-exec] )) || { print -u2 -- 'pi-sandbox: sandbox-exec not found; refusing to run unsandboxed'; exit 1 }
[[ -r $profile ]] || { print -u2 -- "pi-sandbox: profile missing: $profile; refusing to run unsandboxed"; exit 1 }

# The worktree and the stores its git and jj write to, all outside the worktree in a linked checkout.
wt=${PWD:A} gitdir=${PWD:A} jjdir=${PWD:A}/.jj system=0
if top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
  wt=${top:A}
  gitdir=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir)
  gitdir=${gitdir:A}
  jjdir=$wt/.jj
  # A secondary jj workspace points at the shared store through .jj/repo.
  [[ -f $wt/.jj/repo ]] && jjdir=$wt/.jj/$(<$wt/.jj/repo)
  jjdir=${jjdir:A}
  # System repos keep their harness folders read-only for Pi (the profile's SYSTEM block).
  case ${gitdir:h:t} in dotfiles|llm-wiki|agent-events) system=1 ;; esac
  # The agent-review extension watches decisions/; the profile lets it read but not create it.
  mkdir -p -- "$wt/.pi/agent-review/decisions"
fi

# Provider keys come from the secrets file here, outside the sandbox, one at a time;
# inside it ~/secrets is unreadable, so Pi sees only these keys.
pi_keys=(OPENCODE_API_KEY CONTEXT7_API_KEY)
for key_name in $pi_keys; do
  if key_value=$(SECRETS_ENV=${PI_VIEW_SECRETS:-$HOME/secrets/.env} "$script_dir/secret-get" "$key_name" 2>/dev/null); then
    export "$key_name=$key_value"
  fi
done

exec sandbox-exec -f "$profile" -D WT="$wt" -D GITDIR="$gitdir" -D JJDIR="$jjdir" \
  -D TMP="${${TMPDIR:-/tmp}:A}" -D HOME="$HOME" -D SYSTEM="$system" "$@"
