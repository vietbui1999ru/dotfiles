#!/usr/bin/env python3
"""Human control for one-review-per-Pi-run mode."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

RUN_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}", re.I)
HASH = re.compile(r"[0-9a-f]{40}")


def repo_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode:
        raise SystemExit("agent-review: run inside a git repository")
    return Path(result.stdout.strip())


def mode_path(root: Path) -> Path:
    return root / ".pi" / "agent-review" / "mode.json"


def read_json(path: Path) -> dict[str, object] | None:
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) else None


def write_mode(path: Path, mode: str, set_by: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "mode": mode,
        "setBy": set_by,
        "at": datetime.now(timezone.utc).isoformat(),
    }
    fd, temporary = tempfile.mkstemp(prefix="mode.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(payload, stream)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:
    result = subprocess.run(
        ["git", *args], cwd=root, env=env, capture_output=True, text=True, timeout=15
    )
    if result.returncode:
        raise RuntimeError(f"git {args[0]} failed")
    return result.stdout.strip()


def snapshot_tree(root: Path) -> str:
    """Working-tree hash, computed exactly as Pi's snapshot() does."""
    clean = {k: v for k, v in os.environ.items() if k not in ("GIT_INDEX_FILE", "GIT_DIR", "GIT_WORK_TREE")}
    real_index = Path(root, git(root, "rev-parse", "--git-path", "index", env=clean))
    scratch = Path(tempfile.mkdtemp())
    try:
        index = scratch / "index"
        if real_index.exists():
            shutil.copyfile(real_index, index)
        env = {**clean, "GIT_INDEX_FILE": str(index)}
        git(root, "add", "-A", "--", ".", env=env)
        git(root, "rm", "-r", "--cached", "--quiet", "--ignore-unmatch", "--", ".pi", env=env)
        return git(root, "write-tree", env=env)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def worktrees(root: Path) -> list[tuple[Path, str]]:
    """Every worktree of this repo as (path, branch); branch is "" when detached."""
    out = git(root, "worktree", "list", "--porcelain")
    trees: list[tuple[Path, str]] = []
    for block in out.split("\n\n"):
        lines = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
        if "worktree" in lines:
            branch = lines.get("branch", "").removeprefix("refs/heads/")
            trees.append((Path(lines["worktree"]), branch))
    return trees


def default_ref(root: Path) -> str:
    """origin's default branch as last fetched; no network."""
    try:
        return git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    except RuntimeError:
        return "origin/main"


def landed(root: Path, base: str, end: str, ref: str) -> bool:
    """True when ref already contains the run's base..end change (reverse-applies cleanly).

    Checked in a throwaway index, so the worktree and its real index are untouched.
    Binary patches and any git error count as not landed.
    """
    try:
        patch = git(root, "diff", "--no-renames", "--binary", base, end)
    except RuntimeError:
        return False
    if not patch:
        return True
    if "GIT binary patch" in patch or "Binary files" in patch:
        return False
    scratch = Path(tempfile.mkdtemp())
    try:
        env = {**os.environ, "GIT_INDEX_FILE": str(scratch / "index")}
        git(root, "read-tree", ref, env=env)
        result = subprocess.run(
            ["git", "apply", "--reverse", "--check", "--cached"],
            cwd=root, env=env, input=patch + "\n", capture_output=True, text=True, timeout=15,
        )
        return result.returncode == 0
    except (RuntimeError, subprocess.TimeoutExpired):
        return False
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def scan(root: Path, every: bool) -> list[dict[str, object]]:
    """Pending reviews in this worktree, or in every worktree, plus orphan refs when every."""
    trees = worktrees(root) if every else [(root, git(root, "branch", "--show-current"))]
    ref = default_ref(root)
    found: list[dict[str, object]] = []
    for tree, branch in trees:
        pending = tree / ".pi" / "agent-review" / "pending"
        if not pending.is_dir():
            continue
        for path in sorted(pending.iterdir()):
            run_id, kind = path.stem, path.suffix
            if kind not in (".json", ".processing") or not RUN_ID.fullmatch(run_id):
                continue
            record = read_json(path) or {}
            hashes = all(isinstance(record.get(k), str) and HASH.fullmatch(record[k]) for k in ("base", "end"))
            # Same test as approve's already-decided refusal: only Pi or a skip can clear it.
            decision = read_json(tree / ".pi" / "agent-review" / "decisions" / f"{run_id}.json")
            decided = decision is not None and not quiet_decision(decision, {"runId": run_id, "endTree": record.get("endTree")})
            found.append({
                "runId": run_id, "owner": str(tree), "branch": branch,
                "name": record.get("name") or "", "startedAt": record.get("startedAt") or "",
                "processing": kind == ".processing", "error": "error" in record,
                "landed": hashes and landed(tree, record["base"], record["end"], ref),
                "decided": decided, "orphan": False,
            })
    if every:
        held = {entry["runId"] for entry in found}
        refs = git(root, "for-each-ref", "--format=%(refname)", "refs/agent-review/").splitlines()
        for run_id in sorted({r.split("/")[2] for r in refs if r.count("/") >= 3} - held):
            found.append({"runId": run_id, "owner": None, "branch": "", "name": "", "startedAt": "",
                          "processing": False, "error": False, "landed": False, "decided": False, "orphan": True})
    return sorted(found, key=lambda entry: (entry["orphan"], str(entry["startedAt"])))


def registry_path() -> Path:
    """Every repo that has had a pending review, one main-worktree path per line (Pi writes it)."""
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "agent-review" / "repos"


def main_worktree(root: Path) -> Path:
    common = Path(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    return common.parent if common.name == ".git" else common


def global_scan() -> list[dict[str, object]]:
    """Reviews in every registered repo plus the current one, each tagged with its repo."""
    try:
        roots = [Path(line) for line in registry_path().read_text().splitlines() if line.strip()]
    except OSError:
        roots = []
    try:
        roots.append(repo_root())
    except SystemExit:
        pass  # outside a repository: registered repos only
    seen: set[Path] = set()
    found: list[dict[str, object]] = []
    for root in roots:
        try:
            main = main_worktree(root)
        except (RuntimeError, OSError, subprocess.TimeoutExpired):
            continue  # missing, or no longer a git repository
        if main not in seen:
            seen.add(main)
            found += [{**entry, "repo": str(main)} for entry in scan(main, True)]
    return sorted(found, key=lambda entry: (entry["orphan"], str(entry["startedAt"])))


def find_owner(root: Path, run_id: str) -> Path | None:
    """The worktree whose pending directory holds run_id (as .json or .processing)."""
    for tree, _branch in worktrees(root):
        pending = tree / ".pi" / "agent-review" / "pending"
        if (pending / f"{run_id}.json").exists() or (pending / f"{run_id}.processing").exists():
            return tree
    return None


def confirm(root: Path, run_id: str, files: list[str]) -> bool:
    """Ask the person, in a dialog an agent cannot click. No bypass by design."""
    shown = ", ".join(files[:10])
    message = f"Approve Pi run {run_id[:8]} in {root.name}?\n\n{len(files)} file(s): {shown}"
    script = [
        "on run argv",
        'display dialog (item 1 of argv) with title "agent-review" buttons {"Cancel", "Approve"} '
        'default button "Cancel" cancel button "Cancel" giving up after 25',
        "return button returned of result",
        "end run",
    ]
    command = ["/usr/bin/osascript"] + [a for line in script for a in ("-e", line)] + [message]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=30)
    except Exception:
        return False
    return result.returncode == 0 and result.stdout.strip() == "Approve"


class Refusal(Exception):
    def __init__(self, reason: str, message: str) -> None:
        super().__init__(message)
        self.reason, self.message = reason, message


def reply(ok: bool, **fields: object) -> int:
    print(json.dumps({"ok": ok, **fields}))
    return 0 if ok else 2


def write_decision(path: Path, payload: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f"{path.stem}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(payload, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load_pending(d: Path, run_id: str) -> dict[str, object]:
    pending = d / "pending"
    if (pending / f"{run_id}.processing").exists():
        raise Refusal("processing", "Pi is consuming it, or an interrupted claim; /review skip <id> in Pi")
    if not (pending / f"{run_id}.json").exists():
        raise Refusal("no-pending", "no pending review with that id in this checkout")
    record = read_json(pending / f"{run_id}.json")
    if record is None or record.get("runId") != run_id:
        raise Refusal("invalid-pending", "pending record unreadable or id mismatch")
    if "error" in record:  # before the tree check: an error record has endTree == baseTree
        raise Refusal("snapshot-failed", "the run's end snapshot failed; review in Neovim")
    if "tamper" in record:
        raise Refusal("tampered", "mode.json changed during the run; review in Neovim")
    hashes = all(isinstance(record.get(k), str) and HASH.fullmatch(record[k]) for k in ("base", "end", "baseTree", "endTree"))
    if not hashes or not isinstance(record.get("files"), list):
        raise Refusal("invalid-pending", "pending record has a malformed field")
    return record


def quiet_decision(decision: dict[str, object] | None, record: dict[str, object]) -> bool:
    """An accept-all decision for this run that Pi would consume without a follow-up."""
    if decision is None or decision.get("skipped") or decision.get("notes") != []:
        return False
    files = decision.get("files")
    return (
        decision.get("runId") == record["runId"]
        and decision.get("endTree") == decision.get("finalTree") == record["endTree"]
        and not str(decision.get("patch", "")).strip()
        and isinstance(files, list)
        and all(isinstance(f, dict) and f.get("status") == "accepted" for f in files)
    )


def consume(root: Path, d: Path, run_id: str, record: dict[str, object], files: list[str], decided: bool = False) -> None:
    """Decision D1: no Pi process is left to consume the decision, so do it here.

    With decided, a quiet Neovim decision already exists; keep it as written.
    """
    pending = d / "pending" / f"{run_id}.json"
    claim = d / "pending" / f"{run_id}.processing"
    try:
        os.rename(pending, claim)
    except FileNotFoundError:
        raise Refusal("processing", "another process claimed it first")
    try:
        tree = snapshot_tree(root)
        if tree != record["endTree"]:
            os.rename(claim, pending)
            raise Refusal("tree-changed", "the working tree changed while confirming")
        if not decided:
            write_decision(d / "decisions" / f"{run_id}.json", {
                "runId": run_id, "endTree": record["endTree"], "finalTree": tree,
                "files": [{"file": f, "status": "accepted"} for f in files],
                "notes": [], "patch": "", "via": "agent-review approve",
            })
        os.remove(claim)
    except Refusal:
        raise
    except BaseException:
        if claim.exists():
            os.rename(claim, pending)
        raise
    delete_refs(root, run_id)


def delete_refs(root: Path, run_id: str) -> None:
    for ref in ("base", "end"):
        subprocess.run(["git", "update-ref", "-d", f"refs/agent-review/{run_id}/{ref}"], cwd=root, capture_output=True)


def approve(run_id: str) -> int:
    if not RUN_ID.fullmatch(run_id):
        raise Refusal("invalid-id", "not a run id")
    try:
        here = repo_root()
    except SystemExit:
        raise Refusal("error", "not a git repository")
    root = find_owner(here, run_id) or here  # act in the worktree that holds the review
    d = root / ".pi" / "agent-review"
    record = load_pending(d, run_id)
    decided = (d / "decisions" / f"{run_id}.json").exists()
    # A pi -p run has exited, so a Neovim decision for it is never consumed. An accept-all
    # one asks Pi for nothing, so finish it here; any other needs Pi to read it.
    if decided and not quiet_decision(read_json(d / "decisions" / f"{run_id}.json"), record):
        raise Refusal("already-decided", "a decision with notes, changes or a skip exists; open Pi in its worktree, or skip")
    if snapshot_tree(root) != record["endTree"]:
        raise Refusal("tree-changed", "the working tree changed since the run ended")
    files = [f["file"] for f in record["files"] if isinstance(f, dict) and isinstance(f.get("file"), str)]
    if not confirm(root, run_id, files):
        raise Refusal("not-confirmed", "approval needs the person to confirm the dialog")
    consume(root, d, run_id, record, files, decided)
    return reply(True, runId=run_id)


def skip(run_id: str) -> int:
    """Dismiss a review without approving it, in one step and with no agent turn.

    The pending record is claimed (renamed) before the decision is written, so a live
    Pi watcher in the owner finds no pending record and sends no follow-up.
    """
    if not RUN_ID.fullmatch(run_id):
        raise Refusal("invalid-id", "not a run id")
    try:
        here = repo_root()
    except SystemExit:
        raise Refusal("error", "not a git repository")
    owner = find_owner(here, run_id)
    if owner is None:
        if not git(here, "for-each-ref", "--format=%(refname)", f"refs/agent-review/{run_id}/"):
            raise Refusal("no-pending", "no pending review or refs with that id in any worktree")
        delete_refs(here, run_id)
        return reply(True, runId=run_id, orphan=True)
    d = owner / ".pi" / "agent-review"
    pending, claim = d / "pending" / f"{run_id}.json", d / "pending" / f"{run_id}.processing"
    if claim.exists():
        raise Refusal("processing", "Pi is consuming it, or an interrupted claim")
    record = read_json(pending) or {}
    try:
        os.rename(pending, claim)
    except FileNotFoundError:
        raise Refusal("processing", "another process claimed it first")
    try:
        try:
            final = snapshot_tree(owner)
        except (RuntimeError, OSError, subprocess.TimeoutExpired):
            final = ""  # skip must work even when snapshots fail
        write_decision(d / "decisions" / f"{run_id}.json", {
            "runId": run_id, "endTree": record.get("endTree", ""), "finalTree": final,
            "files": [], "notes": [], "patch": "", "skipped": True, "via": "agent-review skip",
        })
        os.remove(claim)
    except BaseException:
        if claim.exists():
            os.rename(claim, pending)
        raise
    delete_refs(owner, run_id)
    return reply(True, runId=run_id, owner=str(owner))


def command_skip(args: argparse.Namespace) -> int:
    """One JSON line on stdout; exit 0 only on success."""
    try:
        return skip(args.run_id)
    except Refusal as refusal:
        return reply(False, reason=refusal.reason, message=refusal.message)
    except BaseException as error:
        return reply(False, reason="error", message=type(error).__name__)


def command_list(args: argparse.Namespace) -> int:
    entries = global_scan() if args.glob else scan(repo_root(), args.all)
    if args.json:
        print(json.dumps(entries))
        return 0
    for e in entries:
        tags = [t for t in ("landed", "decided", "processing", "error", "orphan") if e[t]]
        where = "(no worktree)" if e["orphan"] else f"{e['owner']} [{e['branch'] or 'detached'}]"
        repo = f"{Path(str(e['repo'])).name}  " if args.glob else ""
        print(f"{repo}{e['name'] or '-'}  {str(e['runId'])[:8]}  {where}  {e['startedAt']}  {' '.join(tags)}".rstrip())
    if not entries:
        print("no pending reviews")
    return 0


def command_register(_args: argparse.Namespace) -> int:
    main = main_worktree(repo_root())
    path = registry_path()
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = []
    if str(main) not in lines:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as stream:
            stream.write(f"{main}\n")
    print(f"agent-review: registered {main}")
    return 0


def command_approve(args: argparse.Namespace) -> int:
    """One JSON line on stdout, nothing on stderr; exit 0 only on success."""
    try:
        return approve(args.run_id)
    except Refusal as refusal:
        return reply(False, reason=refusal.reason, message=refusal.message)
    except BaseException as error:
        return reply(False, reason="error", message=type(error).__name__)


def command_mode(args: argparse.Namespace) -> int:
    root = repo_root()
    write_mode(mode_path(root), args.mode, "human")
    print(f"agent-review: mode={args.mode} setBy=human")
    return 0


def command_status(_args: argparse.Namespace) -> int:
    root = repo_root()
    base = root / ".pi" / "agent-review"
    mode = read_json(base / "mode.json")
    pending = sorted((base / "pending").glob("*.json")) if (base / "pending").is_dir() else []
    decisions = sorted(
        (base / "decisions").glob("*.json"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    ) if (base / "decisions").is_dir() else []
    print(f"mode: {(mode or {}).get('mode', 'on')} (no mode file means on)")
    print(f"pending: {len(pending)}")
    print(f"last decision: {decisions[0] if decisions else 'none'}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Control human Agent Review mode")
    subparsers = parser.add_subparsers(dest="command", required=True)
    mode = subparsers.add_parser("mode", help="set review mode for future runs")
    mode.add_argument("mode", choices=("on", "off"))
    mode.set_defaults(handler=command_mode)
    status = subparsers.add_parser("status", help="show review mode and records")
    status.set_defaults(handler=command_status)
    approve_parser = subparsers.add_parser("approve", help="approve one unchanged Pi run after a dialog")
    approve_parser.add_argument("run_id")
    approve_parser.set_defaults(handler=command_approve)
    list_parser = subparsers.add_parser("list", help="list pending reviews (--all: every worktree)")
    list_parser.add_argument("--all", action="store_true", help="scan every worktree and orphan refs")
    list_parser.add_argument("--global", dest="glob", action="store_true",
                             help="every registered repo plus this one, each entry with its repo")
    list_parser.add_argument("--json", action="store_true", help="one JSON array on stdout")
    list_parser.set_defaults(handler=command_list)
    register_parser = subparsers.add_parser("register", help="add this repo to the list --global registry")
    register_parser.set_defaults(handler=command_register)
    skip_parser = subparsers.add_parser("skip", help="dismiss one review without approving it, from any worktree")
    skip_parser.add_argument("run_id")
    skip_parser.set_defaults(handler=command_skip)
    args = parser.parse_args()
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
