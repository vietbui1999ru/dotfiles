#!/opt/homebrew/bin/bash

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=40 \
  color=$TRANSPARENT \
  margin=7 \
  y_offset=5 \
  notch_width=200 \
  sticky=on

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font Mono:Bold:16.0"
  label.font="SF Pro:Semibold:13.0"
  icon.color=$ICON_COLOR
  label.color=$LABEL_COLOR
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=2
  label.padding_right=2
  background.corner_radius=11
  background.height=20
)
sketchybar --default "${default[@]}"

##### Separator helper #####
# Usage: add_sep <name> [display]
add_sep() {
  local args=(
    icon=$ICON_SEPARATOR
    icon.color=$SEPARATOR_COLOR
    icon.font="Hack Nerd Font Mono:Regular:16.0"
    icon.padding_left=6
    icon.padding_right=6
    label.drawing=off
    padding_left=0
    padding_right=0
  )
  [[ -n "$2" ]] && args+=(display="$2")
  sketchybar --add item "$1" right --set "$1" "${args[@]}"
}

##### Custom Events #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event agent_state

##### Left Side — AeroSpace Workspaces #####
ORDERED_WORKSPACES=("1" "2" "3" "4" "0" "B" "T" "P" "C" "O" "N" "M" "S" "R")

for sid in "${ORDERED_WORKSPACES[@]}"; do
  icon="${WORKSPACE_ICONS[$sid]:-$sid}"
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change display_change system_woke mouse.entered mouse.exited \
    --set space.$sid \
      icon="$icon" \
      icon.font="Hack Nerd Font Mono:Bold:16.0" \
      icon.padding_left=5 \
      icon.padding_right=4 \
      label.font="sketchybar-app-font:Regular:16.0" \
      label.padding_right=5 \
      label.drawing=on \
      label.y_offset=1 \
      background.corner_radius=25 \
      background.height=26 \
      padding_right=0 \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done
sketchybar --set space.1 padding_left=5

##### Left Side — Chevron + Front App #####
sketchybar --add item chevron left \
           --set chevron \
                 display=$MAIN_DISPLAY \
                 icon=$ICON_CHEVRON \
                 icon.color=$CHEVRON_COLOR \
                 icon.font="Hack Nerd Font Mono:Bold:12.0" \
                 label.drawing=off \
                 padding_left=2 \
                 padding_right=0

sketchybar --add item front_app left \
           --set front_app \
                 display=$MAIN_DISPLAY \
                 icon.drawing=off \
                 label.font="SF Pro:Bold:13.0" \
                 label.color=$APP_NAME_COLOR \
                 width=80 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add item window_title left \
           --set window_title \
                 display=$MAIN_DISPLAY \
                 icon.drawing=off \
                 label.font="SF Pro:Regular:12.0" \
                 label.color=$WINDOW_TITLE_COLOR \
                 label.max_chars=24 \
                 label.width=150 \
                 scroll_texts=on \
                 width=150 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe window_title front_app_switched

# Which app is currently the system's audio source (browser tab playing
# video, Music, Spotify, ...) — app name only, no track metadata.
# label.width caps it so it can't push left_pill wider than right_pill;
# scroll_texts wraps the text within that width instead of spilling.
sketchybar --add item audio_source left \
           --set audio_source \
                 display=$MAIN_DISPLAY \
                 icon=$ICON_AUDIO_SOURCE \
                 icon.color=$AUDIO_SOURCE_ICON_COLOR \
                 label.color=$AUDIO_SOURCE_LABEL_COLOR \
                 label.font="SF Pro:Regular:12.0" \
                 label.width=110 \
                 label.max_chars=16 \
                 scroll_texts=on \
                 drawing=off \
                 update_freq=5 \
                 script="$PLUGIN_DIR/audio_source.sh"

sketchybar --add item left_spacer left \
           --set left_spacer \
                 label.drawing=off \
                 icon.drawing=off \
                 background.drawing=off \
                 padding_right=5 \
                 width=0

##### Center — Spotify #####
# source "$CONFIG_DIR/items/spotify.sh"

##### Right Side — System Items #####
# Items are added right-to-left (first added = rightmost)

# Herdr plan/build agent status. label.width fixed + scroll_texts, same as
# window_title/audio_source's fixed-width labels — this is a right_pill
# item, unrelated to left_pill's now-dynamic workspace width.
# 210 covers both status words at their longest ("? unknown" x2, measured
# 200px) with a small margin; a NEXT-step suffix already exceeds this and
# relies on scroll_texts to show it without resizing — that was already
# true at 260, which didn't fit the NEXT case either, just wasted space on
# the far more common status-only display.
sketchybar --add item agents right \
           --set agents \
                 icon.drawing=off \
                 label.max_chars=300 \
                 label.width=210 \
                 label.font="Hack Nerd Font Mono:Regular:13.0" \
                 scroll_texts=on \
                 click_script="$PLUGIN_DIR/agents.sh" \
                 script="$PLUGIN_DIR/agents.sh" \
           --subscribe agents agent_state

add_sep sep.agents


sketchybar --add item clock right \
           --set clock \
                 icon=$ICON_CLOCK \
                 padding_right=5 \
                 update_freq=60 \
                 script="$PLUGIN_DIR/clock.sh"

add_sep sep.cal

sketchybar --add item calendar right \
           --set calendar \
                 padding_right=-1 \
                 icon=$ICON_CALENDAR \
                 update_freq=3600 \
                 script="$PLUGIN_DIR/calendar.sh"

add_sep sep.mic $MAIN_DISPLAY

sketchybar --add item mic right \
           --set mic \
                 icon=$ICON_MIC \
                 label.width=42 \
                 label.align=right \
                 update_freq=3 \
                 script="$PLUGIN_DIR/mic.sh" \
                 click_script="$PLUGIN_DIR/mic_click.sh"

