#!/opt/homebrew/bin/bash
# Bar setup and item order. Each item group lives in items/<group>.sh and
# its runtime script in plugins/. The bar is static by design: no --animate
# anywhere, fixed widths wherever content changes, and balance_pills.sh only
# redraws a spacer when a pill's width really changed.

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Layout profile (wide external vs compact laptop) #####
# Picks the TARGET display — the external, when attached, not whatever macOS
# itself calls "main" (verified live 2026-09-28: docked with the lid open,
# macOS still reported the built-in as main) — then loads the sizes for it.
# items/display_watch.sh re-runs this whole file when that target changes
# (dock/undock).
"$PLUGIN_DIR/display_profile.sh" detect
source "$CONFIG_DIR/profile.sh"

##### Bar Appearance #####
# display=$BAR_DISPLAY: one bar, on the target display only (its arrangement-
# id, resolved fresh each run — that numbering isn't stable across docks).
# That makes per-item `display=` pointless, so no item sets it.
# notch_width only applies to a notched built-in panel; harmless elsewhere.
sketchybar --bar \
  display=$BAR_DISPLAY \
  position=top \
  height=40 \
  color=$TRANSPARENT \
  margin=$BAR_MARGIN \
  y_offset=10 \
  notch_width=$BAR_NOTCH_W \
  sticky=on

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font Mono:Bold:16.0"
  label.font="SF Pro:Semibold:13.0"
  icon.color=$ICON_COLOR
  label.color=$LABEL_COLOR
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=2
  label.padding_right=2
  background.corner_radius=11
  background.height=20
)
sketchybar --default "${default[@]}"

##### Separator helper (used by items/*.sh) #####
# Usage: add_sep <name>
add_sep() {
  local args=(
    icon=$ICON_SEPARATOR
    icon.color=$SEPARATOR_COLOR
    icon.font="Hack Nerd Font Mono:Regular:16.0"
    icon.padding_left=6
    icon.padding_right=6
    label.drawing=off
    padding_left=0
    padding_right=0
  )
  sketchybar --add item "$1" right --set "$1" "${args[@]}"
}

##### Custom Events #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event agent_state

##### Items #####
# Left side, left to right.
source "$ITEM_DIR/workspaces.sh"
source "$ITEM_DIR/front_app.sh"
# Right side, right to left (first sourced = rightmost).
source "$ITEM_DIR/agents.sh"
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/mic.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/vpn.sh"
# Pills last: brackets can only group items that already exist.
source "$ITEM_DIR/brackets.sh"
source "$ITEM_DIR/display_watch.sh"

##### Force Initial Update #####
sketchybar --update

##### Equalize pill widths (deferred — bar must finish drawing first) #####
# Initial paint only; ongoing balance is re-triggered from aerospace.sh,
# audio_source.sh and vpn.sh on every event that can change a pill's width.
( sleep 3; CALLER=startup "$PLUGIN_DIR/balance_pills.sh" ) &
