##### Pill Brackets #####
sketchybar --add bracket left_pill \
             space.1 space.2 space.3 space.4 space.0 \
             space.B space.T space.P space.C space.O \
             space.N space.M space.S space.R \
             chevron front_app window_title audio_source left_spacer \
           --set left_pill \
             background.color=$ISLAND_BG \
             background.corner_radius=25 \
             background.height=37 \
             background.padding_left=7 \
             background.drawing=on

sketchybar --add bracket right_pill \
             right_spacer \
             vpn.tailscale vpn.protonvpn sep.vpn \
             mic sep.mic \
             calendar sep.cal \
             clock sep.agents agents \
           --set right_pill \
             background.color=$ISLAND_BG \
             background.corner_radius=25 \
             background.height=37 \
             background.padding_right=7 \
             background.drawing=on

##### Force Initial Update #####
sketchybar --update

##### Equalize pill widths (deferred — bar must finish drawing first) #####
# Initial paint only; ongoing balance is re-triggered from aerospace.sh and
# vpn.sh on every event that can change either pill's width.
( sleep 3; CALLER=startup "$PLUGIN_DIR/balance_pills.sh" ) &
