# Pi routing used by ~/.claude/skills/delegate-pi/pi-router.sh.
# Leave a value blank to let pi use ~/.pi/agent/settings.json defaults.

# Council diff gate routes one evaluator per dimension.
PI_COUNCIL_ACCEPTANCE_MODEL="openai-codex/gpt-6.1-sol:high"
PI_COUNCIL_CODE_QUALITY_MODEL="opencode-go/deepseek-v4-pro:high"
PI_COUNCIL_STYLE_MODEL="opencode-go/deepseek-v4-pro:high"

# Async/sync delegation tiers.
# Thinking off: pi-lens and context-mode add unsaved messages per request, breaking Claude's signed thinking from turn 2.
PI_DELEGATE_HIGH_MODEL="opencode-go/claude-haiku-5-5:off"
# deepseek-v4.1-flash has no "medium" thinking level; Pi raises :medium to :high, so medium effort is :low.
PI_DELEGATE_MEDIUM_MODEL="opencode-go/deepseek-v4.1-flash:low"
PI_DELEGATE_LOW_MODEL="opencode-go/deepseek-v4.1-flash:off"
PI_COUNCIL_SECURITY_MODEL="opencode-go/glm-5.3:high"
