# Linux counterpart of launchd com.vietbui.headroom-proxy. Stowed from dotfiles/systemd.
[Unit]
Description=Headroom compression proxy (Claude Code, Codex) on 127.0.0.1:8787
Documentation=https://github.com/chopratejas/headroom

[Service]
# Loopback only: the tailnet reaches it through `tailscale serve`, never a public bind.
ExecStart=%h/.local/bin/headroom proxy --host 127.0.0.1 --port 8787 --mode cache
# No anonymous upload; HEADROOM_TELEMETRY=off would also kill local /stats.
# HEADROOM_KOMPRESS_BACKEND is deliberately unset: pytorch_mps is macOS-only, so
# Linux runs the default int8 ONNX model on the CPU.
Environment=HEADROOM_BEACON=off
Environment=PATH=%h/.local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
# Logs go to the journal: journalctl --user -u headroom-proxy -f

[Install]
WantedBy=default.target
