# Linux counterpart of launchd com.vietbui.headroom-dash. Stowed from dotfiles/systemd.
[Unit]
Description=Headroom merged dashboard on 127.0.0.1:8790

[Service]
ExecStart=/usr/bin/python3 -m http.server 8790 --bind 127.0.0.1 --directory %h/dotfiles/headroom/dashboard
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
