.DS_Store
nvim/.config/nvim/.claude/
/.pi/nvim-context.json
/.pi/nvim-servername
/.pi/nvim-preview.json
/.pi/nvim-requests.jsonl
/.pi/nvim-decisions.jsonl
/.pi/panel.state.json
/.pi/status/
/.pi/agent-review/
**/.pi/status/
**/.pi/panel.state.json
.agent-workflow.local.json
/.agents/sessions/
/.agents/events.jsonl
/.agents/inbox/
/.agents/claimed/
/.agents/done/
/.agents/approvals/
/.agents/council/
/.agents/annotations/
kitty/.config/kitty/kitty-os.conf
kitty/.config/kitty/*.bak
.firecrawl/

# Generated agent artifacts and caches
**/.claude-plugin/types/
.pi-lens-probe-home/
.pi-subagents/
__pycache__/


# Backup files — rely on git history, no .bak convention (json.bak already covered elsewhere)
*.md.bak
# Per-session agent scratch/state that must never be committed
/pi-session-*.html
/.Codex/
**/session-state.md
/.pi/diff-review/

# Installed dependencies. nvim/.gitignore covers its own copy; this catches the
# rest, including pi extension packages whose tests need a real install.
node_modules/

# Machine-local runtime state: Claude worktrees, pi-lens binaries and caches,
# jj per-repo metadata, Claude.ai-synced skills,
# and the per-checkout state the Serena and Playwright MCP servers write.
.claude/worktrees/
.serena/
.playwright-mcp/
pi/.pi-lens/
jj/.config/jj/repos/
claude/.claude/skills/synced/
